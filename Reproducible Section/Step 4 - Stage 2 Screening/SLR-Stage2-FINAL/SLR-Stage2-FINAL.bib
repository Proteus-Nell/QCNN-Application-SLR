	pages = {1027 -- 1033},
	file = {PDF:files/358/Prasad et al. - 2024 - An Optimized Equivariant Quantum Network for Ingenious Building Monitoring and Control using an Andr.pdf:application/pdf},
}

@inproceedings{vancea_predicting_2025,
