	volume = {32},
	issn = {1558-0210},
	doi = {10.1109/TNSRE.2024.3385336},
	abstract = {The purpose of this work is to analyze how new technologies can enhance clinical practice while also examining the physical traits of emotional expressiveness of face expression in a number of psychiatric illnesses. Hence, in this work, an automatic facial expression recognition system has been proposed that analyzes static, sequential, or video facial images from medical healthcare data to detect emotions in people's facial regions. The proposed method has been implemented in five steps. The first step is image preprocessing, where a facial region of interest has been segmented from the input image. The second component includes a classical deep feature representation and the quantum part that involves successive sets of quantum convolutional layers followed by random quantum variational circuits for feature learning. Here, the proposed system has attained a faster training approach using the proposed quantum convolutional neural network approach that takes {\textbackslash}mathbb \{O\}\{(\}{\textbackslash}text \{log\}\{(\}\{n\}\{)\}\{)\} time. In contrast, the classical convolutional neural network models have {\textbackslash}mathbb \{O\}\{(\}\{n\}{\textasciicircum}\{\{2\}\}\{)\} time. Additionally, some performance improvement techniques, such as image augmentation, fine-tuning, matrix normalization, and transfer learning methods, have been applied to the recognition system. Finally, the scores due to classical and quantum deep learning models are fused to improve the performance of the proposed method. Extensive experimentation with Karolinska-directed emotional faces (KDEF), Static Facial Expressions in the Wild (SFEW 2.0), and Facial Expression Recognition 2013 (FER-2013) benchmark databases and compared with other state-of-the-art methods that show the improvement of the proposed system.},
	journal = {IEEE Transactions on Neural Systems and Rehabilitation Engineering},
	publisher = {IEEE},
	author = {Hossain, S. and Umer, S. and Rout, R. K. and Marzouqi, H. A.},
	year = {2024},
	keywords = {EPPI-Reviewer, convolutional neural network, Facial expression, mental health conditions, quantum, quantum variational circuit, quanvolutional, recognition},
	pages = {1556 -- 1565},
	file = {Full Text PDF:files/305/Hossain et al. - 2024 - A Deep Quantum Convolutional Neural Network Based Facial Expression Recognition For Mental Health An.pdf:application/pdf},
}

@article{lawrence_medical_2025,
	title = {Medical {Image} {Recognition} for {Breast} {Cancer} {Detection} {Using} {Hybrid} {Quantum}-{Classical} {Deep} {Learning}},
	doi = {10.1109/IC-EETA66496.2025.11548221},
	abstract = {One of the common and maybe fatal diseases harming women all around, breast cancer is one such condition. Accurate medical image analysis allows for early detection, which can greatly increase survival rates. Although they encounter challenges such as high computational expenses, poor data efficiency, and suboptimal feature extraction, conventional deep learning methods have produced promising results. By using quantum parallelism and entanglement to enable more quick and more complex computations, quantum computing provides a new approach to overcome these limitations. This paper intends to propose a hybrid quantum-classical deep learning model for the identification of breast cancer areas in mammographic images. The proposed method combines a quantum convolutional neural network (QCNN) with a classical convolutional neural network (CNN) to benefit from the advantages accompanying both classical and quantum processing. The hybrid model processes the mammogram data using classical pre-processing and quantum convolution layers; classification then follows with fully connected layers followed by classical pooling. The results of the MIAS dataset experiments indicate a classification accuracy of 98.4\%, which is superior to the operation of traditional CNN and transfer learning-based models.},
	journal = {2025 International Conference on Emerging Engineering Technologies and Applications (IC-EETA)},
	publisher = {IEEE},
	author = {Lawrence, T. S. and Margala, M. and Chakrabarti, P. and S, S. S. and G, N.},
	year = {2025},
	keywords = {EPPI-Reviewer, quantum convolutional neural network, breast cancer detection, hybrid deep learning, medical image analysis, Quantum computing},
	pages = {829 -- 833},
	file = {PDF:files/409/Lawrence et al. - 2025 - Medical Image Recognition for Breast Cancer Detection Using Hybrid Quantum-Classical Deep Learning.pdf:application/pdf},
}

@article{makam_als_2024,
	title = {{ALS} {Detection} {Framework} {Based} on {Automatic} {Singular} {Spectrum} {Analysis} and {Quantum} {Convolutional} {Neural} {Network} {From} {EMG} {Signals}},
	volume = {8},
	issn = {2475-1472},
	doi = {10.1109/LSENS.2024.3449369},
	abstract = {Electromyogram (EMG) signals are recordings of the electrical activity in muscles, which are studied due to their informative nature regarding neuromuscular disorders. Analysis of EMG signals is invaluable for identifying various neuromuscular conditions. In this letter, an automatic singular spectrum analysis (Auto-SSA) and quantum convolutional neural network (QCNN)-based framework is proposed for the detection of amyotrophic lateral sclerosis (ALS) using EMG signals. The Auto-SSA effectively decomposes the EMG signals into reconstructed components, from which the particle swarm optimization extracts the most significant features. The QCNN classifies the extracted features for efficient ALS detection. The proposed framework outperforms the compared state-of-the-art ALS detection frameworks, achieving a testing accuracy of 98.50\%. With the obtained performance, the proposed framework could be a valuable diagnostic tool for ALS neuromuscular conditions.},
	number = {9},
	journal = {IEEE Sensors Letters},
	publisher = {IEEE},
	author = {Makam, K. K. and Singh, V. K. and Pachori, R. B.},
	year = {2024},
	keywords = {EPPI-Reviewer, quantum convolutional neural network (QCNN), Sensor applications, amyotrophic lateral sclerosis (ALS) identification, and quantum machine learning, automatic singular spectrum analysis (Auto-SSA), electromyogram (EMG), particle swarm optimization (PSO)},
	pages = {1 -- 4},
	file = {PDF:files/352/Makam et al. - 2024 - ALS Detection Framework Based on Automatic Singular Spectrum Analysis and Quantum Convolutional Neur.pdf:application/pdf},
}

@article{nguyen_hq-cnn_2026,
	title = {{HQ}-{CNN}: {Hybrid} {Quantum}-{CNN} for {Precise} {Radio}-{Based} {Indoor} {Tracking} in {mmWave} {Networks}},
	issn = {1558-2612},
	doi = {10.1109/WCNC65185.2026.11555410},
	abstract = {Radio-based indoor localization is vital for the Internet of Things (IoT) applications such as smart healthcare. However, existing methods often require intrusive infrastructure or lack sufficient resolution for through-wall tracking. To address this, we propose a hybrid quantum-convolutional neural network-based framework (HQ-CNN) for high-precision localization in massive MIMO environments. The primary motivation for exploiting quantum-inspired techniques is to reduce model size and computational overhead through quantum data encoding, which is essential for resource-constrained IoT devices. Accordingly, the framework first extracts temporal channel state information, such as angle of arrival (AoA), to generate dynamic Angle-Delay Profiles (ADPs), capturing interactions with both static and moving objects. A generative adversarial network (GAN)-based frame prediction is employed for noise suppression and ADP refinement. The core innovation lies in the integration of a hybrid quantum-CNN, which improves learning from high-dimensional ADPs while maintaining low computational and memory overhead on a traditional GPU-based computer. Evaluations on DeepMIMO show the framework outperforms baselines in scalability and competes with their accuracy. This work demonstrates the potential of hybrid quantum-classical technologies for precise radio-based tracking.},
	journal = {2026 IEEE Wireless Communications and Networking Conference (WCNC)},
	publisher = {IEEE},
	author = {Nguyen, V.-L. and Nguyen, L.-H. and Hwang, R.-H.},
	year = {2026},
	keywords = {EPPI-Reviewer, Hybrid quantum CNN, quantum-classical learning, Radio Localization, User tracking},
	pages = {1 -- 6},
	file = {PDF:files/385/Nguyen et al. - 2026 - HQ-CNN Hybrid Quantum-CNN for Precise Radio-Based Indoor Tracking in mmWave Networks.pdf:application/pdf},
}

@article{qi_multi-path_2026,
	title = {Multi-{Path} {Parallel} {Quantum} {Convolutional} {Neural} {Network}},
	doi = {10.1109/MAI69289.2026.11543763},
	abstract = {Quantum Convolutional Neural Networks (QCNN) migrate the convolution and pooling concepts of classical Convolutional Neural Networks (CNN) to variational quantum circuits, showing potential on Noisy Intermediate-Scale Quantum (NISQ) devices. However, traditional QCNN adopts a single-depth circuit structure, which has limitations in multi-scale feature extraction, and is prone to the barren plateau phenomenon during training, making it difficult to adapt to high-dimensional real-world scenarios such as network intrusion detection. This paper proposes a QCNN architecture based on a multi-path parallel structure. For the network intrusion detection task, it draws on the Inception module to construct three parallel quantum convolution paths: shallow, medium, and deep, achieving hierarchical extraction of multi-scale features; residual connections are introduced to preserve encoded state information and provide gradient shortcuts; a hybrid optimization strategy combining classical Adam and Quantum Natural Gradient (QNG) is adopted to adapt to the heterogeneous parameter space. Experimental validation shows that, on the UNSW-NB15 network intrusion detection dataset, the proposed Multi-Path Parallel Quantum Convolutional Neural Network (MP-QCNN) improves detection accuracy by 3\% compared to traditional single-path QCNN and effectively mitigates the barren plateau phenomenon. This design strictly maintains NISQ depth constraints and quantum parallelism advantages, providing an efficient and stable feature extraction framework for high-dimensional tasks such as network intrusion detection.},
	journal = {2026 International Conference on Multi-scale Artificial Intelligence (MAI)},
	publisher = {IEEE},
	author = {Qi, H. and Huo, X. and Gani, A.},
	year = {2026},
	keywords = {EPPI-Reviewer, Inception Migration, Multi- Path Parallel Structure, Quantum Convolutional Neural Network, Quantum Natural Gradient, Residual Connection},
	pages = {1 -- 6},
	file = {PDF:files/406/Qi et al. - 2026 - Multi-Path Parallel Quantum Convolutional Neural Network.pdf:application/pdf},
}

@article{chou_quantum_2025,
	title = {Quantum {Convolutional} {Neural} {Networks} in {Injury} {Detection} of {3D} {Computed} {Tomography} {Volumes}},
	doi = {10.1109/BigData66926.2025.11401688},
	abstract = {The growing prospect of incorporating artificial intelligence into medical diagnosis to enhance the healthcare system necessitates methods to improve the accuracy of classification models capable of processing complex information, such as computed tomography images. Quantum machine learning has garnered attention because of the superior computational capacity of qubits, which may lead to improved pattern recognition and data analysis. However, there is limited information on its ability to process 3D computed tomography volumes, especially from real-world datasets such as the RSNA Abdominal Trauma Injury CT (RATIC) Dataset that present data with more variability and irrelevant details. This study addresses this by proposing four HQCNN MIL-based model variations and evaluating them against a baseline classical model to determine an optimal classification model architecture for the RATIC Dataset. The model is part of a comprehensive data processing pipeline, which involves a 3D CNN image segmentation model that has been modified to increase dimensionality and to incorporate a ResNet encoder. While the performance of two HQCNNs is similar to the baseline, that of the other two is consistently higher, with score differences of approximately 0.06 to 0.13. The results indicate that even with 3D CT data, hybrid machine learning models have the potential to surpass purely classical configurations only when optimally designed, suggesting that careful integration of quantum methods into machine learning pipelines plays a key role in advancing diagnostic accuracy and reliability in clinical practice. Overall, these findings highlight the need for continued exploration of hybrid architectures, particularly in optimizing quantum-classical interactions for robust performance on real-world medical data. © 2025 IEEE.},
	number = {2025},
	journal = {Proceedings of the IEEE International Conference on Big Data, BigData},
	author = {Chou, Li-Yen Alyssa and Islam, Md Majedul and He, Selena},
	year = {2025},
	note = {ISBN: 979-833159447-3},
	pages = {7055 -- 7063},
	file = {PDF:files/452/Chou et al. - 2025 - Quantum Convolutional Neural Networks in Injury Detection of 3D Computed Tomography Volumes.pdf:application/pdf},
}

@inproceedings{pandian_symmetry-protected_2022,
	title = {Symmetry-{Protected} {Topological} {Phase} {Classification} {Using} {Hybrid} {Quantum} {Convolutional} {Neural} {Network} with {Three} {Quantum} {Filters}},
	isbn = {978-1-6654-1120-2},
	doi = {10.1109/ICAECT54875.2022.9807939},
	abstract = {In this research, a Hybrid Quantum Convolutional Neural Network (HQCNN) was proposed for Symmetry-Protected Topological (SPT) Phase data Classification. The HQCNN used quantum Convolutional and pooling layers with traditional fully connected networks. The quantum Convolutional (QConv) and quantum pooling (QPool) layers were developed using quantum circuit states. The TensorFlow quantum package was used to add the outcomes of the quantum circuits to dense layers for efficient classification. A different number of quantum filters were used in the HQCNN model and tested. A different number of quantum filters were used in the HQCNN model design. The performance of the HQCNN models with the different number of quantum filters was compared using validation and testing performance. The simulation results showed that the classification accuracy of the proposed HQCNN with Four Quantum Filters (HQCNN-4QF) was superior to other proposed HQCNNs on the SPT phase data Classification. The HQCNN-4QF model achieved the classification accuracy of 99.22 on SPT phase test data. © 2022 IEEE.},
	booktitle = {2022 2nd {International} {Conference} on {Advances} in {Electrical}, {Computing}, {Communication} and {Sustainable} {Technologies}, {ICAECT} 2022},
	author = {Pandian, Arun and {Kanchanadevi} and Sandeep, Pasupuleti and {Dattatreya} and Anil, S. Naga Sai},
	year = {2022},
	file = {PDF:files/480/Pandian et al. - 2022 - Symmetry-Protected Topological Phase Classification Using Hybrid Quantum Convolutional Neural Networ.pdf:application/pdf},
}

@inproceedings{mewada_quantum_2025,
	title = {Quantum {Convolutional} {Neural} {Network} for {Bone} {Fracture} {Classification} from {X}-{Ray} {Images}},
	volume = {256},
	doi = {10.1016/j.procs.2025.02.222},
	abstract = {Accurate and efficient classification of bone fractures from X-ray images is crucial for timely diagnosis, effective treatment planning, and improved patient outcomes in orthopedic medicine. Convolutional neural networks (CNNs) have demonstrated their ability to automatically extract relevant features from X-ray images, making them a powerful tool for the classification of complex bone fracture patterns. However, as the complexity of the classification task increases, the computational requirements of classical CNNs also grow rapidly. This poses a challenge in high-stakes medical applications, where the accuracy and efficiency of the classification system are paramount. In this work, we present a quantum convolutional neural network (QCNN) for the classification of bone fractures from X-ray images. A quantum convolution layer is integrated as the first layer of the network, which leverages the unique properties of quantum mechanics to extract more informative features from the input X-ray images. A traditional CNN network follows this quantum-based feature extraction step to perform the final bone fracture classification. We tested the proposed QCNN model on the Bone Fracture Multi-Region X-ray Data, a benchmark dataset for evaluating bone fracture classification systems. The QCNN architecture achieved an impressive 96\% accuracy and 95.81\% F1-score, demonstrating its superior performance compared to state-of-The-Art classical CNN models. © 2025 The Author(s).},
	booktitle = {Procedia {Computer} {Science}},
	author = {Mewada, Hiren and Pires, Ivan Miguel and Rahevar, Mrugendrasinh and Khatri, Narendra},
	year = {2025},
	pages = {1143 -- 1150},
	file = {PDF:files/442/Mewada et al. - 2025 - Quantum Convolutional Neural Network for Bone Fracture Classification from X-Ray Images.pdf:application/pdf},
}

@article{naz_quantum_2023,
	title = {Quantum {Mechanism}-{Based} {Convolution} {Model} for the {Classification} of {Pathogenic} {Bacteria}},
	volume = {11},
	doi = {10.1109/ACCESS.2023.3339127},
	abstract = {Water, especially drinking water, should be clean and free of disease-causing bacteria because of its critical role in life. However, it isn't easy to identify and classify them rapidly at an early stage. Primarily, the examination of water is performed manually to check the contamination level. Some researchers have proposed techniques to detect and classify bacteria images, but this field still needs more attention. In this research work, a robust Quantum Convolutional Neural Network (QCNN) classification model is proposed to classify the six major categories of pathogenic bacteria. For the acquisition of pathogen images, different slides are created through the gram-staining process, and then images are captured from those slides. DIBaS is the publicly available dataset that provides these slides captured through gram-staining, which is used to evaluate the proposed methodology. So, in the first step, database preprocessing, small patches are extracted from slide images. However, the extracted patches were not clear and very useful, so the Enhanced Super-Resolution Generative Adversarial Network Model (ESRGAN) was applied to images to improve the image quality of extracted patches. The third step is to extract the deep features and classify bacterial images using the QCNN model, in which the Quantum Convolutional layer is added, and classical data is converted into quantum data to perform classification. Based on the results of classification experiments using the QCNN model, the accuracy is 96.54\%. © 2013 IEEE.},
	journal = {IEEE Access},
	author = {Naz, Isra and Shah, Jamal Hussain and Rehman, Muhammad Habib Ur and Rafiq, Muhammad and Choi, Gyu Sang},
	year = {2023},
	pages = {137747 -- 137757},
	file = {Full Text PDF:files/291/Naz et al. - 2023 - Quantum Mechanism-Based Convolution Model for the Classification of Pathogenic Bacteria.pdf:application/pdf},
}

@article{aravinda_hybrid_2025,
	title = {A {Hybrid} {Quantum}-{Classical} {Approach} for {Multi}-{Class} {Skin} {Disease} {Classification} {Using} a 4-{Qubit} {Model}},
	volume = {13},
	doi = {10.1109/ACCESS.2025.3581030},
	abstract = {Quantum machine learning (QML) presents a promising avenue for addressing complex classification challenges, yet its application in medical imaging remains largely unexplored. This work introduces a hybrid quantum-classical framework designed to classify skin diseases, Chickenpox, Measles, Monkeypox, and Normal, using a 4 qubit quantum system. The framework integrates a Quantum Convolutional Neural Network (QCNN) for feature extraction and a Variational Quantum Classifier (VQC) for classification, processing a dataset of 770 images with significant class imbalance. We employ a class-weighted loss function with weights wyi = [3.0, 3.5, 0.6, 0.4] to address this imbalance, ensuring balanced representation across all classes. The model is optimized using Simultaneous Perturbation Stochastic Approximation (SPSA) over 150 iterations, achieving a test accuracy 70.13\% on a subset of 154 images, representing 20\% of the dataset. This marks a substantial improvement over both a random baseline of 25\% and a prior run that achieved 37.66\% accuracy, which was skewed toward the majority class. Principal Component Analysis (PCA) reduces image features to a 4-dimensional representation, enabling compatibility with the quantum system. The QCNN extracts these features, while the VQC performs classification based on measurements from 1024 shots on the QASM simulator. To ensure practical reusability, the trained model, including quantum circuits, optimized parameters, and PCA transformations, is saved for future deployment. Validation on a separate set of 24 samples (6 per class) yields 70.83\% accuracy (17 out of 24 correct predictions), demonstrating the model’s generalization capabilities. While the performance falls short of classical benchmarks, this study establishes the feasibility of QML with minimal qubits, paving the way for quantum driven diagnostics in resource constrained environments. © 2013 IEEE.},
	journal = {IEEE Access},
	author = {{Aravinda} and Joseph, Emerson Raja and Alasmari, Sultan},
	year = {2025},
	pages = {114460 -- 114470},
	file = {Full Text PDF:files/269/Aravinda et al. - 2025 - A Hybrid Quantum-Classical Approach for Multi-Class Skin Disease Classification Using a 4-Qubit Mode.pdf:application/pdf},
}

@article{bhatia_quantum_2025,
	title = {Quantum {Federated} {Learning} in {Healthcare}: {The} {Shift} from {Development} to {Deployment} and from {Models} to {Data}},
	doi = {10.1109/JBHI.2025.3596156},
	abstract = {Healthcare organizations have a high volume of sensitive data and traditional technologies have limited storage capacity and computational resources. The prospect of sharing healthcare data for machine learning is more arduous due to firm regulations related to patient privacy. In recent years, federated learning has offered a solution to accelerate distributed machine learning addressing concerns related to data privacy and governance. Currently, the blend of quantum computing and machine learning has experienced significant attention from academic institutions and research communities. The ultimate objective of this work is to develop a federated quantum machine learning framework (FQML) to tackle the optimization, security, and privacy challenges in the healthcare industry for medical imaging tasks. In this work, we proposed federated quantum convolutional neural networks (QCNNs) with distributed training across edge devices. To demonstrate the feasibility of the proposed FQML framework, we performed extensive experiments on two benchmark medical datasets (Pneumonia MNIST, and CT kidney disease analysis), which are non-independently and non-identically partitioned among the healthcare institutions/clients. The proposed framework is validated and assessed via large-scale simulations. Based on our results, the quantum simulation experiments achieve performance levels on par with well-known classical CNN models, 86.3\% accuracy on the pneumonia dataset and 92.8\% on the CT-kidney dataset, while requiring fewer model parameters and consuming less data. Moreover, the client selection mechanism is proposed to reduce the computation overhead at each communication round, which effectively improves the convergence rate. © IEEE. 2025 IEEE.},
	journal = {IEEE Journal of Biomedical and Health Informatics},
	author = {Bhatia, Amandeep Singh and Kais, Sabre and Alam, Muhammad Ashraful},
	year = {2025},
	file = {PDF:files/465/Bhatia et al. - 2025 - Quantum Federated Learning in Healthcare The Shift from Development to Deployment and from Models t.pdf:application/pdf},
}

@article{yousif_quantum_2024,
	title = {Quantum {Convolutional} {Neural} {Network} for {Image} {Classification}},
	volume = {15},
	doi = {10.54216/FPA.150205},
	abstract = {In the field of image processing, a well-known model is the Convolutional Neural Network, or CNN. The unique benefit that sets this model apart is its exceptional ability to use the correlation information included in the data. Even with their amazing accomplishment, conventional CNNs could have trouble improving further in terms of generalization, accuracy, and computing economy. However, it could be challenging to train CNN correctly and process information quickly if the model or data dimensions are too large. This is since it will cause the data processing to lag. The Quantum Convolutional Neural Network, or QCNN for short, is a novel proposed quantum solution that might either enhance the functionality of an existing learning model or solve a problem requiring the combination of quantum computing with CNN. To highlight the flexibility and versatility of quantum circuits in improving feature extraction capabilities, this paper compares deep quantum circuit architecture designed for image-based tasks with classical Convolutional Neural Networks (CNNs) and a novel quantum circuit architecture. The covidx-cxr4 dataset was used to train quantum-CNN models, and their results were compared against those of other models. The results show that when paired with innovative feature extraction methods, the suggested deep Quantum Convolutional Neural Network (QCNN) outperformed the conventional CNN in terms of processing speed and recognition accuracy. Even though it required more processing time, QCNN outperformed CNN in terms of recognition accuracy. When training on the covidx-cxr4 dataset, this dominance becomes much more apparent, demonstrating how deeper quantum computing has the potential to completely transform image classification problems. © 2024, American Scientific Publishing Group (ASPG). All rights reserved.},
	number = {2},
	journal = {Fusion: Practice and Applications},
	author = {Yousif, Mohammed and Al-Khateeb, Belal},
	year = {2024},
	pages = {61 -- 72},
	file = {PDF:files/423/Yousif and Al-Khateeb - 2024 - Quantum Convolutional Neural Network for Image Classification.pdf:application/pdf},
}

@article{naik_quantum-inspired_2024,
	title = {Quantum-inspired {Arecanut} {X}-ray image classification using transfer learning},
	volume = {5},
	doi = {10.1049/qtc2.12099},
	abstract = {Arecanut X-ray images accurately represent their internal structure. A comparative analysis of transfer learning-based classification, employing both a traditional convolutional neural network (CNN) and an advanced quantum convolutional neural network (QCNN) approach is conducted. The investigation explores various transfer learning models with different sizes to identify the most suitable one for achieving enhanced accuracy. The Shufflenet model with a scale factor of 2.0 attains the highest classification accuracy of 97.72\% using the QCNN approach, with a model size of 28.40 MB. Out of the 12 transfer learning models tested, 9 exhibit improved classification accuracy when using QCNN models compared to the traditional CNN-based transfer learning approach. Consequently, the exploration of CNN and QCNN-based classification reveals that QCNN outperforms traditional CNN models in accuracy within the transfer learning framework. Further experiments with qubits suggest that utilising 4 qubits is optimal for classification operations in this context. © 2024 The Author(s). IET Quantum Communication published by John Wiley \& Sons Ltd on behalf of The Institution of Engineering and Technology.},
	number = {4},
	journal = {IET Quantum Communication},
	author = {Naik, Praveen M. and Rudra, Bhawana},
	year = {2024},
	pages = {303 -- 309},
	file = {Full Text:files/293/Naik and Rudra - 2024 - Quantum-inspired Arecanut X-ray image classification using transfer learning.pdf:application/pdf},
}

@inproceedings{indhumathi_breast_2025,
	title = {Breast {Cancer} {Severity} {Classification}; {Mesh} {Denoising} {Graph} {Triple} {Attention} with {Stereoscopic} {Scalable} {Quantum} {Convolutional} {Neural} {Networks}},
	isbn = {979-8-3315-0313-0},
	doi = {10.1109/ICDICI66477.2025.11135114},
	abstract = {Breast cancer diagnosis and classification are often hindered by challenges such as low image quality, overlapping tissue features, and the lack of distinct tumor boundaries. These limitations contribute to high false-negative and false-positive rates, reducing diagnostic accuracy. Additionally, the scarcity of annotated data and the computational complexity of existing models further impact their performance. To address these issues, advanced imaging techniques, improved feature extraction, and robust classification strategies are essential. This study presents and validates the Mesh Denoising Graph Triple Attention with Stereoscopic Scalable Quantum Convolutional Neural Networks (MD-GTA-SSQCNNet) for breast cancer severity classification using the MIAS (Mammographic Image Analysis Society) dataset. The process begins with Adaptive Mesh Denoising Guided Normal Filtering (AMDGNF), which enhances image quality. This is followed by segmentation of tumor-affected regions using the Geometric Algebra Transformer (GAT). Feature extraction and classification are carried out using the Graph Triple Attention with Stereoscopic Scalable Quantum Convolutional Neural Network (GTASSQCNNet). To further improve classification accuracy across multiple breast cancer classes, the Osprey Optimization Algorithm (OsOA) is employed; optimizing the model based on tumor class distribution and affected regions. The Pythonbased implementation using the MIAS dataset demonstrates that MD-GTA-SSQCNNet significantly outperforms conventional approaches, achieving 99.9\% classification efficiency and 99.8 \% sensitivity. These results highlight the potential for highly accurate automated systems to assist or even replace manual diagnosis in breast cancer detection. © 2025 IEEE.},
	booktitle = {2025 6th {International} {Conference} on {Data} {Intelligence} and {Cognitive} {Informatics}, {ICDICI} 2025},
	author = {{Indhumathi} and Devi, S. Rukmani and {Asma} and {Kalpana} and {Sandhiya} and {Denis}},
	year = {2025},
	pages = {1117 -- 1123},
	file = {PDF:files/363/Indhumathi et al. - 2025 - Breast Cancer Severity Classification\; Mesh Denoising Graph Triple Attention with Stereoscopic Scala.pdf:application/pdf},
}

@inproceedings{jaison_quantum_2025,
	title = {Quantum {Machine} {Learning} for {Bitter} {Gourd} {Disease} and {Nutrient} {Deficiency} {Detection}},
	isbn = {979-8-3315-6587-9},
	doi = {10.1109/ICAAIC64647.2025.11330296},
	abstract = {The main limitations of agricultural productivity are diseases and shortage of micro-nutrients especially in vegetables like bitter gourd. It is of essence that such stresses are detected early in an attempt to maximize the yield so that farming activities can find a place within the sustainability of the environment. The dataset that we have used in this paper is the image dataset of an olive leaf namely OLID-I subset of bitter gourd leaves that has a total of 785 high-resolution images divided into nine different classes, namely, healthy, disease, insect attack and nutrient deficiencies. Note, as the baseline, we use AgriCure-YOLOv8 model, trained on layered augmentations, with reported good performance of mAP score of 92.9\% and a precision of 89.6\% and a recall of 86.6\%. Therefore, in our work we have QML algorithms in mind on leaf stress classification and using the result offered by the YOLOv8 baseline as the starting point we carry out scale-up analysis. Three models are compared and contrasted; the Quantum Convolutional Neural Network (QCNN) which is a Hierarchical Quantum Feature Extraction, the Variational Quantum Classifier (VQC) which is a direct quantum classification and a Hybrid Quantum-Classical Classifier (HQ-CC), in which the classical pre-classification is performed before the quantum classification. The obtained findings indicate that the quantum models are workable and can be deployed to handle small but complicated agronomic data and yield benefits in the realms of generalization performance and feature representations. In comparison to the YOLOv8 baseline accuracy, the paper presents quantum models, where the additional performance is demonstrated on identifying nutrient deficiencies, which is the most significant outcome that will be utilized in entering this new paradigm technology of smart agriculture, and in resource-poor environments, in particular, where plant stress is of paramount importance.In contrast to the current deep learning-based systems like the YOLOv8, the proposed quantum models have a higher generalization capability based on small and complex dataset and higher sensitivity to detect nutrient deficiencies. This means that QML is applicable in a resource-constrained agricultural setting. © 2025 IEEE.},
	booktitle = {4th {International} {Conference} on {Applied} {Artificial} {Intelligence} and {Computing}, {ICAAIC} 2025},
	author = {Jaison, Shawn and {Narmadha} and Sundar, Naveen},
	year = {2025},
	pages = {179 -- 186},
	file = {PDF:files/454/Jaison et al. - 2025 - Quantum Machine Learning for Bitter Gourd Disease and Nutrient Deficiency Detection.pdf:application/pdf},
}

@article{tripathi_anomaly-aware_2026,
	title = {Anomaly-aware quantum convolutional neural network for carbon-efficient job arrival rate prediction in cloud computing},
	volume = {175},
	doi = {10.1016/j.future.2025.108096},
	abstract = {Cloud computing efficiency hinges on accurately forecasting workload fluctuations, especially for job arrivals where resource allocation must adapt in real-time. In this paper, we present QAP-Net (Quantum Arrival Prediction Network), a hybrid model that combines anomaly detection with a quantum + convolutional neural network(CNN) architecture to facilitate carbon-efficient job arrival predictions. The system employs a two-stage pipeline: initially, an Isolation Forest and long short-term memory (LSTM) network identify and reduce the impact of irregular data points in time-series logs. Subsequently, a quantum and CNN-based model called Q-ConvX module uses variational quantum circuits for refined feature extraction, balancing high predictive accuracy with computational efficiency. Our approach specifically addresses key limitations in current forecasting techniques by reducing computational overhead through a quantum-classical hybrid architecture and by improving robustness in dynamic cloud environments via explicit anomaly detection and removal during preprocessing. Beyond these methodological contributions, QAP-Net seamlessly integrates into OpenStack for dynamic auto-scaling, enabling more precise VM provisioning under varying load conditions. Experimental evaluations on Azure VM (2017, 2019) and Google Cluster (2011) datasets(GCD), with aggregation intervals of 10 and 30 minutes, underscore significant resource savings. Precisely, on the Google 2011 dataset, QAP-Net attains an under-provisioning rate of 10.47 \% and an over-provisioning rate of 8.93 \%, outperforming established methods while also demonstrating measurable reductions in carbon emissions during training and inference. These findings highlight the promise of quantum-classical hybrid solutions in addressing operational efficacy and environmental sustainability within contemporary cloud infrastructures. © 2025 Elsevier B.V.},
	journal = {Future Generation Computer Systems},
	author = {Tripathi, Shivani and Misra, Rajiv and {Singh}},
	year = {2026},
	file = {PDF:files/356/Tripathi et al. - 2026 - Anomaly-aware quantum convolutional neural network for carbon-efficient job arrival rate prediction.pdf:application/pdf},
}

@inproceedings{shak_hybrid_2025,
	title = {Hybrid {Quantum}-{Classical} {Neural} {Network} ({HQCNN}) for {Crypto} {Price} {Forecasting}},
	isbn = {979-8-3315-8856-4},
	doi = {10.1109/AIBThings66987.2025.11296267},
	abstract = {Cryptocurrency price prediction remains a challenging problem due to the highly volatile nature of digital asset markets. This study introduces a Hybrid Quantum-Classical Neural Network (HQCNN) for cryptocurrency price forecasting, leveraging quantum feature encoding and extraction with deep learning architectures. The proposed model utilizes Quantum Convolutional Neural Networks (QCNN) to enhance feature representations, which are then processed by classical deep learning models such as Long Short-Term Memory (LSTM) and Transformer networks. Experimental results on historical cryptocurrency data demonstrate that HQCNN outperforms state-of-the-art models. The proposed model achieves a mean absolute error (MAE) of 0.023 and a root mean squared error (RMSE) of 0.036, surpassing traditional deep learning methods such as LSTM (MAE: 0.040, RMSE: 0.056) and Transformerbased models (MAE: 0.035, RMSE: 0.050). Ablation studies confirm the importance of quantum feature encoding, as removing it degrades performance by up to 3 8. 2\%. Additionally, HQCNN reduces inference time to 7 milliseconds, making it suitable for real-time trading applications. Despite its advantages, HQCNN faces challenges related to quantum hardware constraints, training overhead, and interpretability in financial decision-making. Future work will focus on deploying the model on real quantum processors, integrating reinforcement learning for market adaptability, and enhancing interpretability with quantum explainability techniques. © 2025 IEEE.},
	booktitle = {2025 3rd {International} {Conference} on {Artificial} {Intelligence}, {Blockchain}, and {Internet} of {Things}, {AIBThings} 2025},
	author = {Shak, Md Shujan and Rahman, Nabila and Mahmud, Fuad and Das, Ashim Chandra and Eva, Arifa Akter and Sayeema, Anika},
	year = {2025},
	file = {PDF:files/396/Shak et al. - 2025 - Hybrid Quantum-Classical Neural Network (HQCNN) for Crypto Price Forecasting.pdf:application/pdf},
}

@inproceedings{park_hybrid_2026,
	title = {Hybrid {Quantum} {Temporal} {Convolutional} {Networks}},
	isbn = {979-8-3315-6110-9},
	doi = {10.1109/QCNC69040.2026.00149},
	abstract = {Quantum machine learning models for sequential data face scalability challenges with complex multivariate signals. We introduce the Hybrid Quantum Temporal Convolutional Network (HQTCN), which combines classical temporal windowing with a quantum convolutional neural network core. By applying a shared quantum circuit across temporal windows, HQTCN captures long-range dependencies while achieving significant parameter reduction. Evaluated on synthetic NARMA sequences and high-dimensional EEG time-series, HQTCN performs competitively with classical baselines on univariate data and outperforms all baselines on multivariate tasks. The model demonstrates particular strength under data-limited conditions, maintaining high performance with substantially fewer parameters than conventional approaches. These results establish HQTCN as a parameter-efficient approach for multivariate time-series analysis. © 2026 IEEE.},
	booktitle = {Proceedings - 2026 {International} {Conference} on {Quantum} {Communications}, {Networking}, and {Computing}, {QCNC} 2026},
	author = {Park, Junghoon Justin and Pak, Maria and Lee, Sebin and Chen, Samuel Yen-Chi and Yoo, Shinjae and Tseng, Huan-Hsin and Cha, Jiook},
	year = {2026},
	pages = {906 -- 911},
	file = {Hybrid_Quantum_Temporal_Convolutional_Networks:files/394/Hybrid_Quantum_Temporal_Convolutional_Networks.pdf:application/pdf},
}

@inproceedings{tong_quantum_2026,
	title = {Quantum {Convolutional} {Neural} {Networks} ({QCNN}) for {6G} {Multi}-{User} {Interference} {Mitigation}},
	isbn = {979-8-4007-2173-1},
	doi = {10.1145/3796315.3796356},
	abstract = {This paper investigates advanced signal processing techniques to address the critical challenge of Multi-User Interference (MUI) within the demanding framework of 6th Generation (6G) wireless systems. The study presents a direct comparative analysis between classical deep learning and emerging quantum machine learning paradigms. We first establish the capabilities of Convolutional Neural Networks (CNNs), a state-of-the-art deep learning model, in handling the complex, non-ideal channel environments of modern wireless communications. Subsequently, we explore the theoretical advantages and practical performance of Quantum Convolutional Neural Networks (QCNNs), positing them as a next-generation solution for processing unprecedented data complexity. Through rigorous simulation in a multi-user SIMO uplink scenario, this paper demonstrates that QCNN consistently outperforms its classical CNN counterpart in both signal detection accuracy and overall system sum rate, particularly in low signal-to-noise ratio (SNR) regimes, all while utilizing significantly fewer model parameters. The core contribution of this work is to provide direct empirical evidence of the potential quantum advantage offered by QCNNs for the complex signal processing tasks inherent to future 6G systems. © 2026 Copyright held by the owner/author(s)},
	booktitle = {{ICSIM} 2026 - {Proceedings} of 2026 the 9th {International} {Conference} on {Software} {Engineering} and {Information} {Management}},
	author = {Tong, KiChang and Kim, JaEun and Jung, YeongGyun and Jeong, HyeYoon and Choi, MinHyeok and Song, HyoungKyu},
	year = {2026},
	pages = {299 -- 303},
	file = {Full Text PDF:files/290/Tong et al. - 2026 - Quantum Convolutional Neural Networks (QCNN) for 6G Multi-User Interference Mitigation.pdf:application/pdf},
}

@article{qu_iomt-based_2024,
	title = {{IoMT}-{Based} {Smart} {Healthcare} {Detection} {System} {Driven} by {Quantum} {Blockchain} and {Quantum} {Neural} {Network}},
	volume = {28},
	doi = {10.1109/JBHI.2023.3288199},
	abstract = {Electrocardiogram (ECG) is the main criterion for arrhythmia detection. As a means of identification, ECG leakage seems to be a common occurrence due to the development of the Internet of Medical Things. The advent of the quantum era makes it difficult for classical blockchain technology to provide security for ECG data storage. Therefore, from the perspective of safety and practicality, this article proposes a quantum arrhythmia detection system called QADS, which achieves secure storage and sharing of ECG data based on quantum blockchain technology. Furthermore, a quantum neural network is used in QADS to recognize abnormal ECG data, which contributes to further cardiovascular disease diagnosis. Each quantum block stores the hash of the current and previous block to construct a quantum block network. The new quantum blockchain algorithm introduces a controlled quantum walk hash function and a quantum authentication protocol to guarantee legitimacy and security while creating new blocks. In addition, this article constructs a hybrid quantum convolutional neural network called HQCNN to extract the temporal features of ECG to detect abnormal heartbeats. The simulation experimental results show that HQCNN achieves an average training and testing accuracy of 94.7\% and 93.6\%. And the detection stability is much higher than classical CNN with the same structure. HQCNN also has certain robustness under the perturbation of quantum noise. Besides, this article demonstrates through mathematical analysis that the proposed quantum blockchain algorithm has strong security and can effectively resist various quantum attacks, such as external attacks, Entanglement-Measure attack and Interception-Measurement-Repeat attack. © 2013 IEEE.},
	number = {6},
	journal = {IEEE Journal of Biomedical and Health Informatics},
	author = {Qu, Zhiguo and Shi, Wenke and Liu, Bo and Gupta, Deepak and Tiwari, Prayag},
	year = {2024},
	pages = {3317 -- 3328},
	file = {PDF:files/401/Qu et al. - 2024 - IoMT-Based Smart Healthcare Detection System Driven by Quantum Blockchain and Quantum Neural Network.pdf:application/pdf},
}

@inproceedings{khatoniar_quantum_2024,
	title = {Quantum {Convolutional} {Neural} {Network} for {Medical} {Image} {Classification}: {A} {Hybrid} {Model}},
	isbn = {979-8-3503-8427-7},
	doi = {10.1109/TQCEBT59414.2024.10545121},
	abstract = {This study explores the application of Quantum Convolutional Neural Networks (QCNNs) in the realm of image classification, particularly focusing on datasets with a highly reduced number of features. We investigate the potential quantum computing holds in processing and classifying image data efficiently, even with limited feature availability. This research investigates QCNNs' application within a highly constrained feature environment, using chest X-ray images to distinguish between normal and pneumonia cases. Our findings demonstrate QCNNs' utility in classifying images from the dataset with drastically reduced feature dimensions, highlighting QCNNs' robustness and their promising future in machine learning and computer vision. Additionally, this study sheds light on the scalability of QCNNs and their adaptability across various training-test splits, emphasizing their potential to enhance computational efficiency in machine learning tasks. This suggests a possibility of paradigm shift in how we approach data-intensive challenges in the era of quantum computing. We are looking into quantum paradigms like Quantum Support Vector Machine (QSVM) going forward so that we can explore trade offs effectiveness of different classical and quantum computing techniques. © 2024 IEEE.},
	booktitle = {{TQCEBT} 2024 - 2nd {IEEE} {International} {Conference} on {Trends} in {Quantum} {Computing} and {Emerging} {Business} {Technologies} 2024},
	author = {Khatoniar, Ria and Vyas, Vishu and Acharya, Videet and Saxena, Anshul and Saxena, Amit and Neiwal, Rahul and Korgaonkar, Kunal},
	year = {2024},
	file = {PDF:files/444/Khatoniar et al. - 2024 - Quantum Convolutional Neural Network for Medical Image Classification A Hybrid Model.pdf:application/pdf},
}

@article{ahmad_quantum_2025,
	title = {Quantum {CNN} for {Detection} and {Identification} of {UAV}-{Enabled} {Non}-{Terrestrial} {Networks}},
	volume = {32},
	doi = {10.1109/MWC.001.2400419},
	abstract = {Unmanned aerial vehicles (UAVs) have become essential elements of non-terrestrial networks (NTNs) utilized in various sectors, including agriculture, public safety, surveillance, and critical military operations. However, in addition to the benefits of these NTNs, they are increasingly being exploited for malicious purposes, leading to a heightened need for timely detection and identification. Despite advances in UAV detection, challenges remain, particularly in dealing with different UAV types, the payloads they carry, and their flight characteristics. Relying on a single convolutional neural network (CNN) for UAV detection and identification presents difficulties in managing diverse datasets and capturing complex, interdependent relationships. To address this, we propose a novel approach that integrates the visual geometry group-based CNN for UAV detection and the mask region-based CNN for the identification of various traits of UAVs. Additionally, to overcome the computational complexity of deep convolutional layers, we introduce a quantum computation-based CNN (QCNN) instead of the conventional CNN, applied in both the visual geometry group-based detection and mask region-based identification processes, jointly termed VM-QCNN. To effectively deploy VM-QCNN, we enhance the dataset by applying data augmentation techniques, which add diversity to the training data. This ensures the model accurately detects various UAV types, payload categories, and flight characteristics. Performance evaluation through simulations demonstrates that the VM-QCNN approach significantly improves the detection of malicious UAVs compared to competitive algorithms. © 2002-2012 IEEE.},
	number = {3},
	journal = {IEEE Wireless Communications},
	author = {Ahmad, Ishtiaq and Narmeen, Ramsha and Mughal, Umair Ahmad and Yang, Liang and Almadhor, Ahmad and Dhahbi, Sami and Wen, Miaowen and Ho, Pin-Han},
	year = {2025},
	pages = {28 -- 36},
	file = {PDF:files/438/Ahmad et al. - 2025 - Quantum CNN for Detection and Identification of UAV-Enabled Non-Terrestrial Networks.pdf:application/pdf},
}

@inproceedings{park_its--me_2025,
	title = {It's-{A}-{Me}, {Quantum} {Mario}: {Scalable} {Quantum} {Reinforcement} {Learning} with {Multi}-{Chip} {Ensembles}},
	isbn = {979-8-3315-6986-0},
	doi = {10.1109/QAI63978.2025.00063},
	abstract = {Quantum reinforcement learning (QRL) promises compact function approximators with access to vast Hilbert spaces, but its practical progress is slowed by NISQ-era constraints such as limited qubits and noise accumulation. We introduce a multi-chip ensemble framework using multiple small Quantum Convolutional Neural Networks (QCNNs) to overcome these constraints. Our approach partitions complex, high-dimensional observations from the Super Mario Bros environment across independent quantum circuits, then classically aggregates their outputs within a Double Deep Q-Network (DDQN) framework. This modular architecture enables QRL in complex environments previously inaccessible to quantum agents, achieving superior performance and learning stability compared to classical baselines and single-chip quantum models. The multichip ensemble demonstrates enhanced scalability by reducing information loss from dimensionality reduction while remaining implementable on near-term quantum hardware, providing a practical pathway for applying QRL to real-world problems. © 2025 IEEE.},
	booktitle = {Proceedings - 2025 {IEEE} {International} {Conference} on {Quantum} {Artificial} {Intelligence}, {QAI} 2025},
	author = {Park, Junghoon Justin and Tseng, Huan-Hsin and Yoo, Shinjae and Chen, Samuel Yen-Chi and Cha, Jiook},
	year = {2025},
	pages = {366 -- 372},
	file = {PDF:files/400/Park et al. - 2025 - It's-A-Me, Quantum Mario Scalable Quantum Reinforcement Learning with Multi-Chip Ensembles.pdf:application/pdf},
}

@article{qu_qcacnn_2025,
	title = {{QCACNN}: {A} {Quantum} {Convolutional} {Neural} {Network} {Algorithm} for {Traffic} {Sign} {Recognition} in {Carbon}-{Intelligent} {Electric} {Vehicles}},
	volume = {12},
	doi = {10.1109/JIOT.2025.3553897},
	abstract = {Traffic sign recognition is essential for autonomous driving, enhancing driving efficiency and ensuring road safety. Traffic signs utilize colors and patterns to relay critical information, with color accuracy being especially significant. Traditional models, reliant on extensive data and computing resources, struggle to meet the efficiency demands of electric vehicles with carbon-intelligent computing. Leveraging the physical properties of quantum superposition states, quantum computing offers a solution with its unique parallel computing capabilities, potentially enhancing recognition efficiency and facilitating real-time processing. Quantum convolutional neural networks (QCNNs) show promise in processing large-scale image data with improved efficiency and accuracy. However, most of QCNN researches focus on grayscale image classification, with limited studies on multichannel data. This article introduces the quantum channel attention convolutional neural network (QCACNN), which incorporates a quantum channel attention layer (QCAL) to enhance multichannel data classification. The experimental results demonstrate that QCACNNs surpasses traditional QCNNs in traffic sign recognition, performing comparably to conventional CNNs and SENet models with fewer computing resources. Detailed performance analysis and ablation studies validate the effectiveness of each component within this architecture. Quantum noise resistance tests confirm the robustness of QCACNN, making it a viable solution for electric vehicles with enhanced scalability. © IEEE. 2014 IEEE.},
	number = {17},
	journal = {IEEE Internet of Things Journal},
	author = {Qu, Zhiguo and Xia, Yichen and Sun, Le and Liu, Wenjie and Muhammad, Ghulam},
	year = {2025},
	pages = {34708 -- 34719},
	file = {PDF:files/428/Qu et al. - 2025 - QCACNN A Quantum Convolutional Neural Network Algorithm for Traffic Sign Recognition in Carbon-Inte.pdf:application/pdf},
}

@article{dastagir_towards_2024,
	title = {Towards {Hybrid} {Quantum}-{Classical} {Deep} {Learning} {Architecture} for {Indoor}-{Outdoor} {Detection} {Using} {QCNN}-{LSTM} and {Cluster} {State} {Signal} {Processing}},
	volume = {31},
	doi = {10.1109/LSP.2024.3480043},
	abstract = {Quantum computing, combined with deep learning, leverages principles like superposition and entanglement to enhance complex data-driven tasks. The Noisy Intermediate-Scale Quantum (NISQ) era presents opportunities for hybrid quantum-classical architectures to address this challenge. Despite significant progress, practical applications of these hybrid models are limited. This letter proposes a novel hybrid quantum-classical deep learning architecture, integrating Quantum Convolutional Neural Networks (QCNNs) and Long-Short-Term Memory (LSTM) networks, enhanced by Cluster State Signal Processing. Furthermore, this letter addresses indoor-outdoor detection using high-dimensional signal data, utilizing the Cirq platform - a Python framework for developing and simulating Noisy Intermediate Scale Quantum (NISQ) circuits on quantum computers and simulators. The approach addresses noise and decoherence issues. Preliminary results show that the QCNN-LSTM model outperforms pure quantum and hybrid models in accuracy and efficiency. This validates the practical benefits of hybrid architectures, paving the way for advancements in complex data classification like indoor-outdoor detection. © 1994-2012 IEEE.},
	journal = {IEEE Signal Processing Letters},
	author = {Dastagir, Muhammad Bilal Akram and Han, Dongsoo},
	year = {2024},
	pages = {2945 -- 2949},
	file = {PDF:files/482/Dastagir and Han - 2024 - Towards Hybrid Quantum-Classical Deep Learning Architecture for Indoor-Outdoor Detection Using QCNN-.pdf:application/pdf},
}

@inproceedings{kashtan_hybrid_2025,
	title = {Hybrid quantum {CNN}-based information technology for building semanticsegmentation in aerial imagery},
	volume = {4015},
	doi = {10.31110/colins/2025-3/011},
	abstract = {This paper presents information technology for semantic segmentation of building objects in high-resolution aerospace images using a hybrid quantum convolutional neural network (QCNN). Quantitative and visual evaluations demonstrate the effectiveness of the proposed approach compared to classical segmentation models such as U-Net, CNN, and FCN. The hybrid QCNN model achieved high pixel classification accuracy, with a mean accuracy of 0.98 on the training set and 0.97 on the validation set, indicating robust object recognition. Loss values reached minimal levels (0.05 training, 0.07 validation), confirming efficient training without overfitting. Intersection over Union (IoU) scores were 0.90 and 0.89 for training and validation sets, respectively, demonstrating precise building contour delineation. Testing on diverse urban scenes yielded 100\% detection accuracy without false positives or negatives. Training dynamics showed rapid convergence, with mean average precision (mAP) increasing to 0.35–0.45 and mAP@50:95 reaching 0.20–0.30, stabilizing after 50 epochs. The proposed technology effectively segments buildings under varying density, geometric complexity, shadows, and background noise. The hybrid QCNN approach enhances segmentation quality and generalization to new images. The results confirm the practical applicability of the developed technology for geospatial monitoring, urban planning, and mapping based on aerospace imagery. © 2025 Copyright for this paper by its authors. Use permitted under Creative Commons License Attribution 4.0 International (CC BY 4.0).},
	booktitle = {{CEUR} {Workshop} {Proceedings}},
	author = {Kashtan, Vita and Hnatushenko, Volodymyr and Babets, Dmytro and Cyran, Krzysztof and Wereszczyński, Kamil},
	year = {2025},
	pages = {150 -- 162},
	file = {Full Text:files/278/Kashtan et al. - 2025 - Hybrid quantum CNN-based information technology for building semanticsegmentation in aerial imagery.pdf:application/pdf},
}

@inproceedings{hossain_leveraging_2024,
	title = {Leveraging {Deep} {Quantum} {Convolutional} {Neural} {Networks} for {Student} {Facial} {Expression} {Identifcation} and {Mode} {Assessments}},
	isbn = {979-8-3315-2963-5},
	doi = {10.1109/ICUIS64676.2024.10866158},
	abstract = {The incorporation of modern technologies into education has transformed how learning is seen and assessed, with a rising emphasis on understanding student behavior using facial expression recognition (FER). Recognizing students' emotional and cognitive states can provide vital insights into their engagement and learning styles, allowing teachers to adjust their teaching tactics in real time. Traditional machine learning algorithms have been used to solve this problem, but they frequently struggle with the complexity of facial expressions and big datasets, resulting in limitations in accuracy and processing efficiency. This study explores the potential of quantum computing in addressing these challenges through the development of a Deep Quantum Convolutional Neural Network (QCNN) architecture. By combining the advanced image processing capabilities of convolutional neural networks (CNNs) with the computational power of quantum features such as superposition and entanglement, we aim to enhance the detection of facial expressions that reflect students' engagement, concentration, frustration, and satisfaction. Finally, the result demonstrates a classification accuracy of 91.58 © 2024 IEEE.},
	booktitle = {Proceedings of the 4th {International} {Conference} on {Ubiquitous} {Computing} and {Intelligent} {Information} {Systems}, {ICUIS} 2024},
	author = {Hossain, Javed and Alam, Md Nur and Akib, Mohammad Yasin Nur and Kogoya, Krisdahim},
	year = {2024},
	pages = {68 -- 74},
	file = {PDF:files/413/Hossain et al. - 2024 - Leveraging Deep Quantum Convolutional Neural Networks for Student Facial Expression Identifcation an.pdf:application/pdf},
}

@article{li_quantum_2025,
	title = {Quantum splitting convolutional neural network-based distributed quantum disease detection model},
	volume = {655},
	doi = {10.1016/j.neucom.2025.131410},
	abstract = {Quantum computing leverages the properties of superposition and entanglement to enable high-dimensional feature extraction from medical images, demonstrating its potential to improve the accuracy of disease detection. However, practical applications are still constrained by the current performance bottlenecks of quantum hardware and affected by the excessive entangling gate operations. In this work, we propose a distributed quantum disease detection (DQDD) model using quantum splitting convolutional neural network. The DQDD employs a hybrid quantum convolutional neural network (QCNN) to capture low-dimensional and high-dimensional features in medical images. We introduce the quantum circuit splitting technique to our model, reconstructing an 8-qubit QCNN with 5 qubits, while simultaneously reducing the entangling operations in each sub-circuit. The model comprises two core components, the Information Distillation mechanism designed to extract pivotal features and the Non-saliency Filtering mechanism dedicated to eliminating irrelevant patterns. Both components operate cohesively, facilitating parallel computation across single or multiple quantum computing devices. Evaluations on ISIC2017 and HAM10000 skin cancer datasets demonstrate that our model outperforms existing quantum models in skin cancer detection, doing so with fewer parameters. Superior generalization capability is further validated through cross-domain testing on the MedMNIST dataset. © 2025 Elsevier B.V.},
	journal = {Neurocomputing},
	author = {Li, Yangyang and Qi, Zhengya and Li, Yuelin and Yang, Haorui and Shang, Ronghua and Jiao, Licheng},
	year = {2025},
	file = {PDF:files/462/Li et al. - 2025 - Quantum splitting convolutional neural network-based distributed quantum disease detection model.pdf:application/pdf},
}

@article{li_identifying_2026,
	title = {Identifying {Dynamical} {Quantum} {Phase} {Transitions} {With} a {Migratable} {Quantum}-{Classical} {Hybrid} {Neural} {Network}},
	doi = {10.1002/aisy.202600009},
	abstract = {Recent advances in machine learning have significantly facilitated the study of quantum phases and quantum phase transitions in equilibrium. When applied to dynamical phenomena, both classical and quantum networks demand an extensive cost of resources owing to the inclusion of the temporal dimension. Here, we propose a hybrid quantum-classical architecture combining a quantum convolutional neural network (QCNN) with a classical neural network (CNN) to study nonequilibrium dynamics, and demonstrate an application of classifying dynamical quantum phase transitions (DQPTs). The QCNN layer of the hybrid network is responsible for extracting spatial features from quantum states at each time step, and the CNN layer processes the temporal sequence of QCNN outputs for classification. For a nearest-neighbor transverse-field Ising model, numerical simulations show test accuracy exceeding 95\% when identifying DQPTs in quench dynamics, with robustness under single- and two-qubit depolarizing noise. Remarkably, the trained network can be applied without modification to a different Ising model with long–range interaction, showing the potential as a migratable classifier. This hybrid framework circumvents the exponential cost of classical methods and the noise susceptibility of deep quantum circuits, offering a scalable and hardware-efficient approach for characterizing nonequilibrium dynamics. © 2026 The Author(s). Advanced Intelligent Systems published by Wiley-VCH GmbH.},
	journal = {Advanced Intelligent Systems},
	author = {Li, Daili and Yang, Xin-Xin and Wang, Xiaoting and Zhang, Wei},
	year = {2026},
	file = {PDF:files/405/Li et al. - 2026 - Identifying Dynamical Quantum Phase Transitions With a Migratable Quantum-Classical Hybrid Neural Ne.pdf:application/pdf},
}

@inproceedings{akash_quantum_2023,
	title = {Quantum {Convolutional} {Neural} {Network}-based {Online} {Malware} {File} {Detection} for {Smart} {Grid} {Devices}},
	isbn = {979-8-3503-1554-7},
	doi = {10.1109/DMC58182.2023.10412597},
	abstract = {Cybersecurity concerns have arisen due to extensive information exchange among networked smart grid devices which also employ seamless firmware update. An outstanding issue is the presence of malware-injected malicious devices at the grid edge which can cause severe disturbances to grid operations and propagate malware on the power grid. This paper proposes a cloud-based, device-specific malware file detection system for smart grid devices. In the proposed system, a quantum-convolutional neural network (QCNN) with a deep transfer learning (DTL) is designed and implemented in a cloud platform to detect malware files targeting various smart grid devices. The proposed QCNN algorithm incorporates quantum circuits to extract more features from the malware image files than the filter in conventional CNNs and the DTL method to improve detection accuracy for different types of devices (e.g., processor architecture and operating systems). The proposed algorithm is implemented in the IBM Watson Studio cloud platform that utilizes IBM Quantum processor. The experimental results validate that the proposed malware file detection method significantly improves the malware file detection rates compared to the conventional CNN-based method. © 2023 IEEE.},
	booktitle = {2023 {IEEE} {Design} {Methodologies} {Conference}, {DMC} 2023},
	author = {Akash, Alve Rahman and Ahn, BoHyun and Jenkins, Alycia and Khot, Ameya and Silva, Lauren and Tavares-Vengas, Hugo and Kim, Taesic},
	year = {2023},
	file = {PDF:files/448/Akash et al. - 2023 - Quantum Convolutional Neural Network-based Online Malware File Detection for Smart Grid Devices.pdf:application/pdf},
}

@inproceedings{murmu_quantum-enhanced_2026,
	title = {Quantum-{Enhanced} {Convolutional} {Neural} {Network} for {Multiclass} {Potato} {Leaf} {Disease} {Classification}},
	isbn = {979-8-3315-5935-9},
	doi = {10.1109/NQComp68334.2026.11497723},
	abstract = {Potato leaf diseases pose a serious challenge to agricultural sustainability and food security in regions such as West Bengal, India, where potato cultivation plays a vital socio-economic role. Although classical deep learning models demonstrate strong performance, they often suffer from overfitting, limited generalization, and heavy reliance on large labeled datasets, while manual inspection remains time-consuming and error-prone. This work proposes a hybrid Quantum Convolutional Neural Network (QCNN) integrated with 4-qubit parameterized quantum circuits (PQCs) for accurate classification of five major potato leaf disease categories, including nutrient deficiency, fungal, and viral infections. The model incorporates quantum activation layers, quantum softmax, and a focused loss function to enhance non-linear feature representation and multi-class separability. Grad-CAM is employed to improve the interpretability of predictions. Experiments conducted on a diverse, field-collected dataset from Bardhaman, Bankura, and Purulia districts achieve a classification accuracy of 99.94\%, demonstrating superior generalization, robustness, and explainability compared to classical approaches. This study highlights the practical potential of quantum-enhanced AI for precision agriculture. © 2026 IEEE.},
	booktitle = {Proceedings of {International} {Conference} on {Next}-{Gen} {Quantum} and {Advanced} {Computing}: {Algorithms}, {Security}, and {Beyond}, {NQComp} 2026},
	author = {Murmu, Arpan and Mitra, Pritam and Chakrabarti, Amlan},
	year = {2026},
	pages = {533 -- 538},
	file = {PDF:files/464/Murmu et al. - 2026 - Quantum-Enhanced Convolutional Neural Network for Multiclass Potato Leaf Disease Classification.pdf:application/pdf},
}

@inproceedings{kulkarni_quantum_2025,
	title = {Quantum {Convolutional} {Neural} {Network} for {Coffee} {Plant} {Disease} {Diagnosis}},
	isbn = {978-1-6654-5762-0},
	doi = {10.1109/ICWITE64848.2025.11307161},
	abstract = {In modern agriculture, high crop yields and food security depend on early and accurate identification of plant diseases. Deep learning (DL) models like convolutional neural networks (CNNs) have successfully classified plant disease using leaf images. Classical models are adequate for small-scale applications but inefficient for large-scale applications because of their high processing requirements and difficulty in handling highdimensional data. To overcome these challenges, this study proposes the Quantum Convolutional Neural Network (QCNN) by leveraging the Cirq library to introduce quantum circuit simulation. The QCNN model is trained on the Kaggle coffee plant dataset and JMuBEN Mendeley. Quantum Fourier transforms (QFT) are used to preprocess the input images for enhanced quality and to find regions of interest (ROI) for disease lesions. The empirical results prove that the QCNN has drastically improved the model's performance in each phase of the epoch when compared with the traditional CNN model. In the training phase, the QCNN accomplished 96.98\%, whereas the CNN achieved 88.95\% for 150 epochs. Similarly, an effective performance is accomplished during the testing phase by QCNN with 95.89\% in comparison with the CNN performance of 85.77\%. Hence, this work emphasizes the power of QCNN in faster training and analytical capabilities using entanglement and superposition in the quantum domain. © 2025 IEEE.},
	booktitle = {Proceedings of {IEEE} {International} {Conference} for {Women} in {Innovation}, {Technology} and {Entrepreneurship}, {ICWITE} 2025},
	author = {Kulkarni, Savitri and {Shashidhar} and Shenoy, P. Deepa and {Venugopal}},
	year = {2025},
	file = {PDF:files/443/Kulkarni et al. - 2025 - Quantum Convolutional Neural Network for Coffee Plant Disease Diagnosis.pdf:application/pdf},
}

@inproceedings{firdaus_hybrid_2025,
	title = {Hybrid {Quantum}-{Classical} {NN} for {Chest} {X}-{Ray} {Classification} {Using} 2-{Qubit} {Quantum} {Circuits}},
	isbn = {979-8-3315-8066-7},
	doi = {10.1109/ISPACS68724.2025.11383433},
	abstract = {This study investigates the integration of a 2-qubit quantum system into a classical neural network for chest X-ray classification. Three hybrid quantum-classical neural network circuits are evaluated: U-gate with CNOT, IBM QCNN, and RealAmplitudes. A classical convolutional neural network (CNN), specifically ResNet-18, serves as a benchmark. The results show accuracies of 0.9038 for ResNet-18, 0.7981 for U-gate with CNOT, 0.6250 for IBM QCNN, and 0.6250 for RealAmplitudes. The classical ResNet-18 model outperforms all hybrid models, but the U-gate with CNOT circuit demonstrates promising performance, suggesting potential for quantum-enhanced machine learning in medical image classification. © 2025 IEEE.},
	booktitle = {2025 {International} {Symposium} on {Intelligent} {Signal} {Processing} and {Communication} {Systems}, {ISPACS} 2025},
	author = {{Firdaus} and Syafalni, Infall and Ahmadi, Nur and Sutisna, Nana and Mulyawan, Rahmat and Adiono, Trio},
	year = {2025},
	file = {PDF:files/397/Firdaus et al. - 2025 - Hybrid Quantum-Classical NN for Chest X-Ray Classification Using 2-Qubit Quantum Circuits.pdf:application/pdf},
}

@inproceedings{hung_quantum-enhanced_2025,
	title = {Quantum-{Enhanced} {YOLOv8} for {Intelligent} {Safety} {Helmet} {Detection} on {Construction} {Sites}},
	isbn = {979-8-3315-8183-1},
	doi = {10.1109/ICOT68409.2025.11425369},
	abstract = {This paper presents construction site safety is a critical challenge, particularly in monitoring personnel compliance with protective equipment such as safety helmets. Traditional object detection methods, including classical YOLOv8, achieve high accuracy in standard scenarios but often struggle under complex environments characterized by small object sizes, occlusions, variable lighting, and dense human presence. This study proposes a hybrid quantum-classical approach by integrating a quantum convolutional neural network (QCNN) with YOLOv8 for enhanced safety helmet detection. The QCNN module leverages quantum superposition and entanglement to encode and extract high-dimensional feature representations from input images, effectively capturing subtle patterns that may be missed by classical convolutional layers. The quantum features are fused with classical CNN features and processed through YOLOv8's neck and head layers to predict bounding boxes, class labels, and object confidence. Experimental evaluation demonstrates that the proposed Quantum YOLOv8 framework improves small-object detection, enhances robustness against occlusion and lighting variations, and maintains high detection accuracy in dense, cluttered environments. © 2025 IEEE.},
	booktitle = {2025 13th {International} {Conference} on {Orange} {Technology}, {ICOT} 2025},
	author = {Hung, Long-Chen and Hsu, Kuan-Chen and Yu-Ming, Chang},
	year = {2025},
	file = {PDF:files/468/Hung et al. - 2025 - Quantum-Enhanced YOLOv8 for Intelligent Safety Helmet Detection on Construction Sites.pdf:application/pdf},
}

@inproceedings{gao_research_2025,
	title = {Research on {Object} {Detection} {Model} {Based} on {Quantum} {Convolutional} {Neural} {Network}},
	isbn = {979-8-3315-2633-7},
	doi = {10.1109/ICPICS66386.2025.11347352},
	abstract = {In recent years, object detection technology has undergone substantial evolution within the realms of deep learning and computer vision, particularly owing to the extensive utilization of traditional convolutional neural networks (CNNs). These technologies perform well in a variety of applications, such as autonomous driving, security monitoring, and medical image analysis. However, traditional CNNS face many challenges when dealing with complex scenes and small target detection, such as background interference, target scale change and occlusion. In this paper, a novel Hybrid model, Hybrid Quantum-Cascade FPN, is proposed, which cleverly combines the advantages of Quantum convolutional neural network (QCNN) and classical CNN. The design of Hybrid quantum-Cascade FPN model is divided into three key stages: first, the Quantum coarse screening stage, which quickly extracts low-level features through quantum feature coding; Next is the quantum-classical feature fusion stage, which uses the parallelism of quantum computing and the structural advantages of classical networks to carry out multi-scale feature fusion. The last is the classical fine-Tuning stage, which further optimizes the model to improve the high-level semantic analysis ability. Experiments on multiple data sets show that the model performs well in both detection accuracy and inference speed, especially in complex background and small target detection tasks. © 2025 IEEE.},
	booktitle = {2025 {IEEE} 7th {International} {Conference} on {Power}, {Intelligent} {Computing} and {Systems}, {ICPICS} 2025},
	author = {Gao, Hui},
	year = {2025},
	pages = {937 -- 941},
	file = {PDF:files/475/Gao - 2025 - Research on Object Detection Model Based on Quantum Convolutional Neural Network.pdf:application/pdf},
}

@article{rajamohana_evaluation_2025,
	title = {An {Evaluation} of {FRQI} and {NEQR} {Encoding} {Using} {QCNN} for {Forecasting} {Tropical} {Cyclone} {Intensity}},
	volume = {29},
	doi = {10.13053/cys-29-3-5448},
	abstract = {Effective weather forecasting for cyclones is crucial for minimizing harm to both people and the environment. Accurate estimation of tropical cyclone (TC) intensity is essential for disaster prevention. Although convolutional neural networks (CNNs) have improved this process, they often struggle to capture global spatial relationships in images. Quantum Image Processing (QIP) leverages quantum computing advantages but faces challenges such as noise and hardware limitations. This study represents the first effort to estimate tropical cyclone intensity prediction using two popular quantum image representation formats: Flexible Representation of Quantum Images (FRQI) and a Novel Enhanced Quantum Representation (NEQR), as data encoders in Quantum Convolutional Neural Networks (QCNN) utilizing INSAT 3D satellite images. By employing TCs from 2012 to 2021 as training data, the model achieved an overall mean square error (MSE) of 0.0384 for FRQI and 0.0002 for NEQR. The findings indicate that NEQR significantly outperforms FRQI in cyclone image prediction. © 2025, Instituto Politecnico Nacional. All rights reserved.},
	number = {3},
	journal = {Computacion y Sistemas},
	author = {{Rajamohana} and Yelamali, Vani and Mahendran, K. Sakthi and Jain, Ritik and Durai, Karthiganesh},
	year = {2025},
	pages = {1671 -- 1677},
	file = {Full Text PDF:files/312/Rajamohana et al. - 2025 - An Evaluation of FRQI and NEQR Encoding Using QCNN for Forecasting Tropical Cyclone Intensity.pdf:application/pdf},
}

@inproceedings{sheoran_intelligent_2025,
	title = {An {Intelligent} {Lung} {Cancer} {Diagnosistic} {System} based {Latent} {Equivariant} {Quantum} {Convolutional} {Neural} {Network} with {Improved} {Orca} {Predation} {Algorithm} using {Histopathological} {Imaging}},
	isbn = {979-8-3315-9929-4},
	doi = {10.1109/ICECA66444.2025.11382974},
	abstract = {Lung cancer is the leading cause of cancer-related mortality in the world and thus outlines the need to discover diagnostic methods beneficial to improve patient survival. Accurate classification of pathological images is essential for sub-typing and as a means for guiding therapy. The current research work presents latent equivariant quantum convolutional neural network (LEQCNN) with improved orca predation algorithm (IOPA) (Latent Equivariant Quantum Convolutional Neural Network augmented with Improved Orca Predation Algorithm or LEqCNN-IoPa) for automating the diagnostic process of lung cancer. Initially, initial stage preprocessing for the LC25000 dataset of histopathological images has been conducted using the Window-Aware Guided Image Filtering (WAGIF) technique to improve structural integrity, and also to reduce artefacts from noise. The improvement is further obtained via segmentation using a Return-(a)-ligned Decision Transformer (RADT) that captures the contextual relationship on pixel level further. The architecture is further enhanced to include Feedback DenseNet201 (FDNet201) which integrates feedback attention with dense connectivity to further improve the saliency of clinically meaningful features in the network. Finally, hyper-parameter optimisation is done by the IOPA meta-hyperparameter algorithm, which is based on biologically inspired exploration-exploitation mechanisms. Experimental results show that the LEQCNN-IOPA can achieve the overall precision of 99.85\%, accuracy of 99.62\%, and sensitivity of 99.59\%. © 2025 IEEE.},
	booktitle = {Proceedings of the 9th {International} {Conference} on {Electronics}, {Communication} and {Aerospace} {Technology}, {ICECA} 2025},
	author = {Sheoran, Jyoti and {Pushpa} and {Kishore} and Upadhye, Vijay Jagdish and Maranan, Ramya and {Sriragavi}},
	year = {2025},
	file = {PDF:files/354/Sheoran et al. - 2025 - An Intelligent Lung Cancer Diagnosistic System based Latent Equivariant Quantum Convolutional Neural.pdf:application/pdf},
}

@inproceedings{tyagi_multi-objective_2025,
	title = {Multi-{Objective} {Task} {Mapping} in {Cloud} {Environments} using {Secretary} {Bird} {Optimized} {Quantum} {Convolutional} {Neural} {Network}},
	isbn = {979-8-3315-9929-4},
	doi = {10.1109/ICECA66444.2025.11383469},
	abstract = {Cloud infrastructure is evolving toward increased dynamism, exhibiting volatile workloads and diverse virtual machines. Within this context, multicriteria task scheduling that maximizes efficacy in Infrastructure-as-a-Service (IaaS) remains a pervasive, unresolved challenge. Contemporary heuristic and deterministic algorithms struggle to optimally reconcile simultaneous objectives - namely, energy consumption, resource utilization, and makespan. Therefore, the introduction of intelligent, adaptive scheduling frameworks is vital for delivering sustained operational efficiency. We propose a novel multi-objective task mapping scheme, designated QCoNNet-SBirdO, in which a secretary-bird species-inspired optimizer directs a quantum convolutional neural network to schedule cloud workloads. The method commences with comprehensive environment profiling - collecting task dependency matrices, utilization metrics, and power consumption at the hypervisor layer. A priority ranking for both task and virtual-machine (VM) candidates is deduced, and this ranking feeds a Quantum Convolutional Neural Network (QCoNNet) that exploits multidimensional resource interactions. Delegated task-to-VM mapping is subsequently derived via Secretary Bird Optimization (SBirdO), which iteratively refines conductivity and depth measurements until scheduling objectives converge. Outcome allocations undergo a reinforcement-control loop to ingest real-time discrepancies and augment fidelity. Empirical evaluations across heterogeneously provisioned cloud environments indicate that QCoNNet-SBirdO achieves a task prioritization accuracy of 99.2\%, a reduction of 38.6\% in energy consumption, a decrease of 41.3\% in allocated resource requirement, and a 99.7\% improvement in mapping velocity when benchmarked against reference heuristics. The results thus corroborate that the QCoNNet-SBirdO framework is both scalable and, in multicriteria terms, decisively superior to contemporary deterministic and meta-heuristic benchmarks across pivotal operational metrics. © 2025 IEEE.},
	booktitle = {Proceedings of the 9th {International} {Conference} on {Electronics}, {Communication} and {Aerospace} {Technology}, {ICECA} 2025},
	author = {Tyagi, Jayant and Benal, Ganga D. and Devarapalli, Shivareddy and Parikh, Swapnil M. and Maranan, Ramya and {Sivaramkrishnan}},
	year = {2025},
	file = {PDF:files/407/Tyagi et al. - 2025 - Multi-Objective Task Mapping in Cloud Environments using Secretary Bird Optimized Quantum Convolutio.pdf:application/pdf},
}

@inproceedings{tasnim_comparison_2024,
	title = {Comparison of {CNN} and {QCNN} {Performance} in {Binary} {Classification} of {Breast} {Cancer} {Histopathological} {Images}},
	isbn = {979-8-3503-6248-0},
	doi = {10.1109/BigData62323.2024.10825102},
	abstract = {Breast cancer is a leading cause of mortality among women, with early detection being crucial for improving outcomes. This study explores the use of Quantum Convolutional Neural Network (QCNN) for automating breast cancer detection through histopathological images. We compare QCNNs with classical Convolutional Neural Network (CNN) for binary classification of benign and malignant tumors using the BreakHis dataset. Our results demonstrate that QCNN outperform CNN in accuracy, especially in smaller batch sizes, and offer faster convergence with improved computational efficiency. This highlights QCNNs' potential in enhancing diagnostic precision and efficiency in medical imaging. © 2024 IEEE.},
	booktitle = {Proceedings - 2024 {IEEE} {International} {Conference} on {Big} {Data}, {BigData} 2024},
	author = {Tasnim, Taieba and Rahman, Mohammad and Wu, Fan},
	year = {2024},
	pages = {3780 -- 3787},
	file = {PDF:files/364/Tasnim et al. - 2024 - Comparison of CNN and QCNN Performance in Binary Classification of Breast Cancer Histopathological I.pdf:application/pdf},
}

@article{roh_fast_2025,
	title = {Fast {Quantum} {Convolutional} {Neural} {Networks} for {Low}-{Complexity} {Object} {Detection} in {Autonomous} {Driving} {Applications}},
	volume = {24},
	doi = {10.1109/TMC.2024.3470328},
	abstract = {Object detection applications, especially in autonomous driving, have drawn attention due to the advancements in deep learning. Additionally, with continuous improvements in classical convolutional neural networks (CNNs), there has been a notable enhancement in both the efficiency and speed of these applications, making autonomous driving more reliable and effective. However, due to the exponentially rapid growth in the complexity and scale of visual signals used in object detection, there are limitations regarding computation speeds while conducting object detection solely with classical computing. Motivated by this, this paper proposes the quantum object detection engine (QODE), which implements a quantum version of CNN, named QCNN, in object detection. Furthermore, this paper proposes a novel fast quantum convolution algorithm that processes the multi-channel of visual signals based on a small number of qubits and constructs the output channel data, thereby achieving relieved computational complexity. Our QODE, equipped with fast quantum convolution, demonstrates feasibility in object detection with multi-channel data, addressing a limitation of current QCNNs due to the scarcity of qubits in the current era of quantum computing. Moreover, this paper introduces a heterogeneous knowledge distillation training algorithm that enhances the performance of our QODE. © 2002-2012 IEEE.},
	number = {2},
	journal = {IEEE Transactions on Mobile Computing},
	author = {Roh, Emily Jimin and Baek, Hankyul and Kim, Donghyeon and Kim, Joongheon},
	year = {2025},
	pages = {1031 -- 1042},
	file = {PDF:files/380/Roh et al. - 2025 - Fast Quantum Convolutional Neural Networks for Low-Complexity Object Detection in Autonomous Driving.pdf:application/pdf},
}

@article{lilhore_hybrid_2026,
	title = {Hybrid {Quantum}-{Inspired} {Transformer} {Network} for {Kidney} {Stone} {Prediction} {Using} {Urine} {Analysis} and {CT} {Scans}},
	volume = {19},
	doi = {10.1007/s44196-025-01138-2},
	abstract = {Kidney stones, in particular those from crystallising calcium oxalate, are a major healthcare issue. They must be accurately and promptly located to ensure effective treatment. Traditional diagnostic modalities including imaging studies and biochemical analysis can be expensive, invasive, and ineffective in prognosticating disease course. In this study, the authors propose HQIT-Net (Hybrid Quantum-Inspired Transformer Network), a new deep learning system for accurately and non-invasively predicting kidney stones by using biochemical indicators in urine and CT image. The novelty of HQIT-Net is that QCNNs and ViT are employed in combination to handle CT images, as well as the application of Bi-Directional LSTM with Attention in order to capture sequential patterns from numerical urine data. The unique incorporation of these modes is the key innovation in this framework, which provides a holistic view of kidney stone formation—structurally and biochemically. The model is trained on two datasets: (1) the dataset of “Physical Characteristics of Urines with and Without Crystals” consisting of scarce urine samples categorized as per six vital attributes (specific gravity, pH, osmolarity, conductivity, urea concentration and calcium concentration); and (2) the PACS CT Kidney dataset(Dhaka), to detect crystallization at kidneys and kidney without stone. To ensure data privacy and improve generalization performance, HQIT-Net adopts a Federated Self-Supervised Learning (FSSL) architecture that supports decentralized training over hospitals without sharing raw data. Experimental results show that HQIT-Net outperforms the state-of-the-art models, such as Swin Transformer, ConvNeXt, EfficientNetV2, DeepLabV3 + and GNNs with an accuracy of 99.1\%, sensitivity of 98.6\%, specificity of 99.3\% and AUC-ROC of 0.998 respectively. HQIT-Net will establish a new benchmark for real-time privacy-preserving detection of kidney stone, which integrates quantum-inspired AI, attention-based learning and multimodal data fusion. © The Author(s) 2026.},
	number = {1},
	journal = {International Journal of Computational Intelligence Systems},
	author = {Lilhore, Umesh Kumar and {Sanaj} and {Priya} and {Rasmi} and Sharma, Rahul Kumar and Tekeste, Lidia Gosy and Ghith, Ehab Seif and Hussien, Shimaa A. and Simaiya, Sarita},
	year = {2026},
	file = {Full Text PDF:files/323/Lilhore et al. - 2026 - Hybrid Quantum-Inspired Transformer Network for Kidney Stone Prediction Using Urine Analysis and CT.pdf:application/pdf},
}

@article{roh_computation-efficient_2025,
	title = {Computation-efficient quantum convolutional neural networks for autonomous driving applications},
	volume = {81},
	doi = {10.1007/s11227-025-07507-0},
	abstract = {This paper proposes a computation-efficient quantum convolutional neural network (CE-QCNN) architecture designed for autonomous driving applications. A key contribution of this work lies in the formulation of a tri-value qubit encoding (TQE) scheme, which compactly embeds three-channel RGB image data into single-qubit states via a sequence of quantum rotations. This strategy enables significant qubit resource reduction while preserving the representational richness of multi-channel visual inputs. The encoded quantum states are subsequently processed through parameterized quantum circuits for convolutional feature extraction, forming the core of the proposed CE-QCNN framework. To further improve learning stability and early-stage performance, a knowledge distillation (KD) strategy is employed, transferring supervision from a pretrained classical CNN model to the quantum network. The proposed model is evaluated on the KITTI dataset, a standard benchmark for autonomous driving, where it demonstrates both competitive detection accuracy and reduced computational complexity. These results substantiate the scalability and practical applicability of CE-QCNNs for future quantum-enhanced perception systems in real-time autonomous driving scenarios. © The Author(s) 2025.},
	number = {8},
	journal = {Journal of Supercomputing},
	author = {Roh, Emily Jimin and Im, Chaemoon and Jeong, Wonjun and Park, Soohyun},
	year = {2025},
	file = {Full Text PDF:files/314/Roh et al. - 2025 - Computation-efficient quantum convolutional neural networks for autonomous driving applications.pdf:application/pdf},
}

@inproceedings{heo_quantum_2025,
	title = {Quantum {CNN}-{GCN}-{Based} {Road} {Hazard} {Detection} with {Lyapunov} {Optimized} {Control}},
	isbn = {979-8-3315-5678-5},
	doi = {10.1109/ICTC66702.2025.11388072},
	abstract = {While Cooperative Adaptive Cruise Control (CACC) enhances traffic efficiency by reducing inter-vehicle distances, shorter headways inevitably make it more challenging to respond promptly and reliably to unexpected road hazards. To address this issue, we assume a system in which Connected Vehicles (CVs) perform real-time hazard detection outside the CACC framework and disseminate the detection results to all vehicles through RSUs. To this end, we propose a lightweight model that integrates Graph Convolutional Networks (GCNs) and Quantum Convolutional Neural Networks (QCNNs), referred to as Quantum Graph-based Object Detection (QGOD), which exhibits a clear trade-off between detection accuracy and processing latency. Furthermore, the model incorporates a Lyapunov optimization-based control mechanism to dynamically adjust the model architecture according to traffic conditions, thereby maximizing the time-average performance. © 2025 IEEE.},
	booktitle = {International {Conference} on {ICT} {Convergence}},
	author = {Heo, Juhui and Park, Soohyun},
	year = {2025},
	pages = {1095 -- 1099},
	file = {PDF:files/437/Heo and Park - 2025 - Quantum CNN-GCN-Based Road Hazard Detection with Lyapunov Optimized Control.pdf:application/pdf},
}

@article{yousif_new_2024,
	title = {A {New} {Quantum} {Circuits} of {Quantum} {Convolutional} {Neural} {Network} for {X}-{Ray} {Images} {Classification}},
	volume = {12},
	doi = {10.1109/ACCESS.2024.3396411},
	abstract = {A common model for classifying images is the convolutional neural network (CNN), which has the benefit of effectively using data correlation information. Despite their remarkable success, classical CNNs may face challenges in achieving further improvements in accuracy, computational efficiency, explainability, and generalization. However, if the specified data dimension or model grows too large, CNN becomes difficult to train effectively with a slowdown processing. In order to address a problem using CNN utilizing quantum computing, Quantum Convolutional Neural Network (QCNN) proposes a novel quantum solution or enhances the functionality of an existing learning model in terms of processing time during training. This paper presents a comparative analysis between classical Convolutional Neural Networks (CNNs) and a novel quantum circuit architecture tailored for image-based tasks, emphasizing the adaptability and versatility of quantum circuits in enhancing feature extraction capabilities and then final accuracy and processing time. A MNIST and covidx-cxr3 datasets was used to train quantum-CNN models, and the results of these comparisons were made with traditional CNN performance. The results demonstrate that the suggested QCNN beat the traditional CNN in terms of recognition accuracy and processing speed (process time) when combined with cutting-edge feature extraction techniques. This superiority is particularly evident when trained on the covidx-cxr3 dataset, highlighting the potential for quantum computing to revolutionize image classification tasks. © 2013 IEEE.},
	journal = {IEEE Access},
	author = {Yousif, Mohammed and Al-Khateeb, Belal and Garcia-Zapirain, Begonya},
	year = {2024},
	pages = {65660 -- 65671},
	file = {Full Text PDF:files/307/Yousif et al. - 2024 - A New Quantum Circuits of Quantum Convolutional Neural Network for X-Ray Images Classification.pdf:application/pdf},
}

@article{nandhini_qcnn_baopt_2023,
	title = {{QCNN}\_BaOpt: {Multi}-{Dimensional} {Data}-{Based} {Traffic}-{Volume} {Prediction} in {Cyber}–{Physical} {Systems}},
	volume = {23},
	doi = {10.3390/s23031485},
	abstract = {The rapid growth of industry and the economy has contributed to a tremendous increase in traffic in all urban areas. People face the problem of traffic congestion frequently in their day-to-day life. To alleviate congestion and provide traffic guidance and control, several types of research have been carried out in the past to develop suitable computational models for short- and long-term traffic. This study developed an effective multi-dimensional dataset-based model in cyber–physical systems for more accurate traffic-volume prediction. The integration of quantum convolutional neural network and Bayesian optimization (QCNN\_BaOpt) constituted the proposed model in this study. Furthermore, optimal tuning of hyperparameters was carried out using Bayesian optimization. The constructed model was evaluated using the US accident dataset records available in Kaggle, which comprise 1.5 million records. The dataset consists of 47 attributes describing spatial and temporal behavior, accidents, and weather characteristics. The efficiency of the proposed model was evaluated by calculating various metrics. The performance of the proposed model was assessed as having an accuracy of 99.3\%. Furthermore, the proposed model was compared against the existing state-of-the-art models to demonstrate its superiority. © 2023 by the authors.},
	number = {3},
	journal = {Sensors},
	author = {Nandhini, Ramesh Sneka and Lakshmanan, Ramanathan},
	year = {2023},
	file = {PDF:files/430/Nandhini and Lakshmanan - 2023 - QCNN_BaOpt Multi-Dimensional Data-Based Traffic-Volume Prediction in Cyber–Physical Systems.pdf:application/pdf},
}

@article{qu_qmfnd_2024,
	title = {{QMFND}: {A} quantum multimodal fusion-based fake news detection model for social media},
	volume = {104},
	doi = {10.1016/j.inffus.2023.102172},
	abstract = {Fake news is frequently disseminated through social media, which significantly impacts public perception and individual decision-making. Accurate identification of fake news on social media is usually time-consuming, laborious, and difficult. Although the leveraging of machine learning technologies can facilitate automated authenticity checks, the time-sensitive and voluminous nature of the data brings considerable challenge for fake news detection. To address this issue, this paper proposes a quantum multimodal fusion-based model for fake news detection (QMFND). QMFND integrates the extracted images and textual features, and passes them through a proposed quantum convolutional neural network (QCNN) to obtain discriminative results. By testing QMFND on two social media datasets, Gossip and Politifact, it is proved that its detection performance is equal to or even surpasses that of classical models. The effects of various parameters are further investigated. The QCNN not only has good expressibility and entangling capability but also has good robustness against quantum noise. The code is available at © 2023 Elsevier B.V.},
	journal = {Information Fusion},
	author = {Qu, Zhiguo and Meng, Yunyi and Muhammad, Ghulam and Tiwari, Prayag},
	year = {2024},
	file = {PDF:files/434/Qu et al. - 2024 - QMFND A quantum multimodal fusion-based fake news detection model for social media.pdf:application/pdf},
}

@article{lourens_hierarchical_2023,
	title = {Hierarchical quantum circuit representations for neural architecture search},
	volume = {9},
	doi = {10.1038/s41534-023-00747-z},
	abstract = {Quantum circuit algorithms often require architectural design choices analogous to those made in constructing neural and tensor networks. These tend to be hierarchical, modular and exhibit repeating patterns. Neural Architecture Search (NAS) attempts to automate neural network design through learning network architecture and achieves state-of-the-art performance. We propose a framework for representing quantum circuit architectures using techniques from NAS, which enables search space design and architecture search. We use this framework to justify the importance of circuit architecture in quantum machine learning by generating a family of Quantum Convolutional Neural Networks (QCNNs) and evaluating them on a music genre classification dataset, GTZAN. Furthermore, we employ a genetic algorithm to perform Quantum Phase Recognition (QPR) as an example of architecture search with our representation. Finally, we implement the framework as an open-source Python package to enable dynamic circuit creation and facilitate circuit search space design for NAS. © 2023, Springer Nature Limited.},
	number = {1},
	journal = {npj Quantum Information},
	author = {Lourens, Matt and Sinayskiy, Ilya and Park, Daniel K. and Blank, Carsten and Petruccione, Francesco},
	year = {2023},
	file = {Full Text PDF:files/276/Lourens et al. - 2023 - Hierarchical quantum circuit representations for neural architecture search.pdf:application/pdf},
}

@article{jeong_hybrid_2023,
	title = {Hybrid {Quantum} {Convolutional} {Neural} {Networks} for {UWB} {Signal} {Classification}},
	volume = {11},
	doi = {10.1109/ACCESS.2023.3323019},
	abstract = {With the increasing requirements for location-based services for Internet of things (IoT) applications, ultrawideband (UWB) technology provides accurate indoor positioning capabilities. However, indoor environments contain various obstacles leading to significant signal propagation effects. This results in errors in the time-of-arrival-based UWB positioning system. Specifically, a non-line-of-sight (NLOS) signal induces additional distance and position errors owing to the path delay compared to a line-of-sight (LOS) signal. Therefore, UWB signal classification is essential for improving positioning accuracy. Recently, various approaches have successfully classified UWB signals, including machine-learning-based methods such as convolutional neural networks (CNNs) and long short-term memory (LSTM). This study proposes a hybrid quantum CNN (HQCNN) inspired by a CNN for UWB signal classification. HQCNN employs a classical layer before a quantum embedding circuit and variational quantum circuits for the convolutional filter. These structures enable efficient training and implementation. We used UWB channel impulse response data to demonstrate the performance of the proposed algorithm and compared the benchmarks with HQCNN using the evaluation metrics. The results showed that the HQCNN outperformed the others. © 2023 The Authors.},
	journal = {IEEE Access},
	author = {Jeong, Seon-Geun and Do, Quang-Vinh and Hwang, Hae-Ji and Hasegawa, Mikio and Sekiya, Hiroo and Hwang, Won-Joo},
	year = {2023},
	pages = {113726 -- 113739},
	file = {Full Text PDF:files/321/Jeong et al. - 2023 - Hybrid Quantum Convolutional Neural Networks for UWB Signal Classification.pdf:application/pdf},
}

@inproceedings{thilagavathy_real-time_2025,
	title = {Real-{Time} {Situational} {Awareness} at {National} {Borders}: {A} {Comparative} {Analysis} of {Classical} and {Hybrid} {QCNN} {Approaches}},
	isbn = {979-8-3315-2480-7},
	doi = {10.1109/RAIT65068.2025.11088906},
	abstract = {Situational awareness at national borders is critical for maintaining security and enabling timely responses to potential threats. In this study, we explore and compare the performance of Classical Convolutional Neural Networks (CNNs) and Hybrid Quantum Convolutional Neural Networks (QCNNs) for real-time alert systems. The primary objective is to identify the algorithm that can deliver the fastest alerts, prioritizing speed over accuracy to ensure quick decision-making and action. By taking advantage of the computational advantages of quantum computing, we aim to determine whether QCNNs can outperform classical CNNs in scenarios where rapid response is paramount. Experimental results demonstrate the potential of both methodologies, with a detailed analysis of their speed performance, offering valuable insights for the deployment of efficient situational awareness systems at national borders. © 2025 IEEE.},
	booktitle = {6th {IEEE} {International} {Conference} on {Recent} {Advances} in {Information} {Technology}, {RAIT} 2025},
	author = {{Thilagavathy} and Aravindan, Madhu Shree},
	year = {2025},
	file = {PDF:files/473/Thilagavathy and Aravindan - 2025 - Real-Time Situational Awareness at National Borders A Comparative Analysis of Classical and Hybrid.pdf:application/pdf},
}

@article{kottapalle_qhf-cs_2025,
	title = {{QHF}-{CS}: {Quantum}-{Enhanced} {Heart} {Failure} {Prediction} {Using} {Quantum} {CNN} with {Optimized} {Feature} {Qubit} {Selection} with {Cuckoo} {Search} in {Skewed} {Clinical} {Data}},
	volume = {84},
	doi = {10.32604/cmc.2025.065287},
	abstract = {Heart failure prediction is crucial as cardiovascular diseases become the leading cause of death worldwide, exacerbated by the COVID-19 pandemic. Age, cholesterol, and blood pressure datasets are becoming inadequate because they cannot capture the complexity of emerging health indicators. These high-dimensional and heterogeneous datasets make traditional machine learning methods difficult, and Skewness and other new biomarkers and psychosocial factors bias the model’s heart health prediction across diverse patient profiles. Modern medical datasets’ complexity and high dimensionality challenge traditional prediction models like Support Vector Machines and Decision Trees. Quantum approaches include QSVM, QkNN, QDT, and others. These Constraints drove research. The “QHF-CS: Quantum-Enhanced Heart Failure Prediction using Quantum CNN with Optimized Feature Qubit Selection with Cuckoo Search in Skewed Clinical Data” system was developed in this research. This novel system leverages a Quantum Convolutional Neural Network (QCNN)-based quantum circuit, enhanced by meta-heuristic algorithms—Cuckoo Search Optimization (CSO), Artificial Bee Colony (ABC), and Particle Swarm Optimization (PSO)—for feature qubit selection. Among these, CSO demonstrated superior performance by consistently identifying the most optimal and least skewed feature subsets, which were then encoded into quantum states for circuit construction. By integrating advanced quantum circuit feature maps like ZZFeatureMap, RealAmplitudes, and EfficientSU2, the QHF-CS model efficiently processes complex, high-dimensional data, capturing intricate patterns that classical models overlook. The QHF-CS model improves precision, recall, F1-score, and accuracy to 0.94, 0.95, 0.94, and 0.94. Quantum computing could revolutionize heart failure diagnostics by improving model accuracy and computational efficiency, enabling complex healthcare diagnostic breakthroughs. Copyright © 2025 The Authors.},
	number = {2},
	journal = {Computers, Materials and Continua},
	author = {Kottapalle, Prasanna and Tak, Tan Kuan and Kshirsagar, Pravin Ramdas and Ginnela, Gopichand and Akula, Vijaya Krishna},
	year = {2025},
	pages = {3857 -- 3892},
	file = {Full Text PDF:files/287/Kottapalle et al. - 2025 - QHF-CS Quantum-Enhanced Heart Failure Prediction Using Quantum CNN with Optimized Feature Qubit Sel.pdf:application/pdf},
}

@inproceedings{badereddine_leveraging_2025,
	title = {Leveraging {Quantum} {Convolutional} {Neural} {Networks} for {Advanced} {Cancer} {Detection}},
	isbn = {979-8-3315-6851-1},
	doi = {10.1109/ICNAS68168.2025.11298029},
	abstract = {Cancer remains one of the leading causes of mortality worldwide, making early and accurate detection a critical challenge in medicine. Recent advances in quantum computing have opened new avenues for enhancing machine learning techniques in medical imaging and diagnosis. In this work, we apply quantum machine learning models, including Quantum Convolutional Neural Networks (QCNN), to the task of breast cancer detection using ultrasound images. We designed and implemented a hybrid pipeline combining classical preprocessing techniques with quantum-enhanced classification. Our experiments were conducted on real medical imaging datasets, and the results demonstrate the potential of quantum approaches to improve diagnostic accuracy over classical baselines. This research lies at the intersection of quantum computing, artificial intelligence, and medical image analysis, and highlights the promise of quantum-enhanced methods in addressing complex healthcare problems. © 2025 IEEE.},
	booktitle = {{ICNAS} 2025 - 7th {International} {Conference} on {Networking} and {Advanced} {Systems}},
	author = {Badereddine, Gherbi and Abdeljalil, Hani and Safia, Djemame},
	year = {2025},
	file = {PDF:files/411/Badereddine et al. - 2025 - Leveraging Quantum Convolutional Neural Networks for Advanced Cancer Detection.pdf:application/pdf},
}

@inproceedings{farsian_benchmarking_2025,
	title = {Benchmarking {Quantum} {Convolutional} {Neural} {Networks} for {Signal} {Classification} in {Simulated} {Gamma}-{Ray} {Burst} {Detection}},
	isbn = {979-8-3315-2493-7},
	doi = {10.1109/PDP66500.2025.00059},
	abstract = {This study evaluates the use of Quantum Convolutional Neural Networks (QCNNs) for identifying signals resembling Gamma-Ray Bursts (GRBs) within simulated astrophysical datasets in the form of light curves. The task addressed here focuses on distinguishing GRB-like signals from background noise in simulated Cherenkov Telescope Array Observatory (CTAO) data, the next-generation astrophysical observatory for very high-energy gamma-ray science. QCNNs, a quantum counterpart of classical Convolutional Neural Networks (CNNs), leverage quantum principles to process and analyze high-dimensional data efficiently. We implemented a hybrid quantum-classical machine learning technique using the Qiskit framework, with the QCNNs trained on a quantum simulator. Several QCNN architectures were tested, employing different encoding methods such as Data Reuploading and Amplitude encoding. Key findings include that QCNNs achieved accuracy comparable to classical CNNs, often surpassing 90\%, while using fewer parameters, potentially leading to more efficient models in terms of computational resources. A benchmark study further examined how hyperparameters like the number of qubits and encoding methods affected performance, with more qubits and advanced encoding methods generally enhancing accuracy but increasing complexity. QCNNs showed robust performance on time-series datasets, successfully detecting GRB signals with high precision. The research is a pioneering effort in applying QCNNs to astrophysics, offering insights into their potential and limitations. This work sets the stage for future investigations to fully realize the advantages of QCNNs in astrophysical data analysis. © 2025 IEEE.},
	booktitle = {Proceedings - 33rd {Euromicro} {International} {Conference} on {Parallel}, {Distributed}, and {Network}-{Based} {Processing}, {PDP} 2025},
	author = {Farsian, Farida and Parmiggiani, Nicolo and Rizzo, Alessandro and Panebianco, Gabriele and Bulgarelli, Andrea and Schilliro, Francesco and Burigana, Carlo and Cardone, Vincenzo and Cappelli, Luca and Meneghetti, Massimo and Murante, Giuseppe and Sarracino, Giuseppe and Scaramella, Roberto and Testa, Vincenzo and Trombetti, Tiziana},
	year = {2025},
	pages = {372 -- 380},
	file = {PDF:files/360/Farsian et al. - 2025 - Benchmarking Quantum Convolutional Neural Networks for Signal Classification in Simulated Gamma-Ray.pdf:application/pdf},
}

@article{nguyen_hybrid_2025,
	title = {Hybrid {Quantum} {Convolutional} {Neural} {Network}-{Aided} {Pilot} {Assignment} in {Cell}-{Free} {Massive} {MIMO} {Systems}},
	volume = {74},
	doi = {10.1109/TVT.2025.3588212},
	abstract = {A sophisticated hybrid quantum convolutional neural network (HQCNN) is conceived for handling the pilot assignment task in cell-free massive MIMO systems, while maximizing the total ergodic sum throughput. The existing model-based solutions found in the literature are inefficient and/or computationally demanding. Similarly, conventional deep neural networks may struggle in the face of high-dimensional inputs, require complex architectures, and their convergence is slow due to training numerous hyperparameters. The proposed HQCNN leverages parameterized quantum circuits (PQCs) relying on superposition for enhanced feature extraction. Specifically, we exploit the same PQC across all the convolutional layers for customizing the neural network and for accelerating the convergence. Our numerical results demonstrate that the proposed HQCNN offers a total network throughput close to that of the excessive-complexity exhaustive search and outperforms the state-of-the-art benchmarks. © 1967-2012 IEEE.},
	number = {12},
	journal = {IEEE Transactions on Vehicular Technology},
	author = {Nguyen, Doan Hieu and Nguyen, Xuan Tung and Jeong, Seon-Geun and Chien, Trinh Van and Hanzo, Lajos and Hwang, Won-Joo},
	year = {2025},
	pages = {19876 -- 19881},
	file = {PDF:files/390/Nguyen et al. - 2025 - Hybrid Quantum Convolutional Neural Network-Aided Pilot Assignment in Cell-Free Massive MIMO Systems.pdf:application/pdf},
}

@inproceedings{manek_quantum_2025,
	title = {Quantum {Convolutional} {Neural} {Networks} for {Medical} {Image} {Diagnosis}},
	isbn = {978-1-6654-5762-0},
	doi = {10.1109/ICWITE64848.2025.11306951},
	abstract = {Recently, Quantum Computing has started being widely used for classical problem solving. We can use Quantum mechanics principles for problem solving. CNN (Convolutional Neural Network) had been used in classical computing and problem solving for many years, the implementation of this neural network model in Quantum devices and circuits is known as QCNN (Quantum Convolutional Neural Network). QCNNs are built using quantum circuits. QCNNs can read complicated pictures more quickly, they are allegedly better at extracting features and identifying patterns, these features can make it extremely good at image classification. By analyzing multiple features at the same time, QCNNs process data faster than classical CNNs and reduce the reliance on big datasets, therefore it addresses difficulties related to limited data. We can also see how robust QCNN is to noise, maintaining good accuracy despite many changes in image quality. Good speed and accuracy are demonstrated in experimental results on training datasets, indicating that QCNNs have the potential to transform medical diagnoses and enhance patient outcomes. We have made use of the chest x-ray image dataset which have three labels, Covid, Pneumonia, and Normal. © 2025 IEEE.},
	booktitle = {Proceedings of {IEEE} {International} {Conference} for {Women} in {Innovation}, {Technology} and {Entrepreneurship}, {ICWITE} 2025},
	author = {Manek, Asha S. and Ganesh, K. Shakthi and Abuzar, Mohammad and Kumar, Chethan and {Jeevitha} and Christa, Sharon},
	year = {2025},
	file = {PDF:files/451/Manek et al. - 2025 - Quantum Convolutional Neural Networks for Medical Image Diagnosis.pdf:application/pdf},
}

@inproceedings{maheshwari_predicting_2025,
	title = {Predicting {Heat} {Plume} {Temperature} and {Spatial} {Location} {Using} {Quantum} {Convolutional} {Neural} {Networks}},
	isbn = {979-8-3315-3159-1},
	doi = {10.1109/QCNC64685.2025.00103},
	abstract = {In this paper, we analyze the potential of quantum computing to provide machine learning based fast and efficient surrogate models for complex simulations. As an example, we focus on the prediction of temperature changes in groundwater caused by geothermal heat pumps in the city of Munich. To account for the current limitations of scalability of quantum computers, we simplify the simulation input and output used for training our surrogate neural network to a small number of parameters. Unlike classical machine learning, quantum computing offers the potential for exponential advantages, potentially overcoming current computational limitations. A Quantum Convolutional Neural Network (QCNN), inspired by the convolution and pooling operations in classical Convolutional Neural Networks (CNNs), leverages parameterized quantum circuits to enhance efficiency. We propose a variant of a QCNN for our application and execute it using the IBM Qiskit's statevector simulator, the IBM Qiskit fake backend, the PennyLane simulator, and an IBM simulator integrated with the PennyLane framework. We use noise models to simulate errors like real quantum computing hardware. The performance of all models was assessed by analyzing their training and testing mean squared error (MSE) losses. © 2025 IEEE.},
	booktitle = {Proceedings - 2025 {International} {Conference} on {Quantum} {Communications}, {Networking}, and {Computing}, {QCNC} 2025},
	author = {Maheshwari, Danyal and Pelzer, Julia and Schulte, Miriam},
	year = {2025},
	pages = {623 -- 627},
	file = {PDF:files/426/Maheshwari et al. - 2025 - Predicting Heat Plume Temperature and Spatial Location Using Quantum Convolutional Neural Networks.pdf:application/pdf},
}

@inproceedings{arepalli_corn_2025,
	title = {Corn {Leaf} {Disease} {Detection} using {Quantum} {CNN}},
	isbn = {979-8-3315-2243-8},
	doi = {10.1109/ICISS63372.2025.11076546},
	abstract = {Corn leaf diseases are one of the biggest challenges undermining crop productivity and ensuring global food security, so early and accurate identification is crucial for proper management of the crop. Although Dense CNN and GoogleNet achieved high accuracies of 98.06\% and 98.7\%, respectively, the models fail to capture more complex relationships and patterns related to various leaf diseases because they use classical deep learning architectures. But with large datasets, the potential comes only in optimizing feature extraction and classification processes. With this, a need arises to introduce Quantum Convolutional Neural Networks (QCNN), where the principle of quantum computing can be utilized to enhance the representation of features for better detection accuracy. The demonstration of our experiments showed that the QCNN achieves a detection accuracy of 99\%, superior to both Dense CNN and GoogleNet. Agriculture. © 2025 IEEE.},
	booktitle = {Proceedings of the 7th {International} {Conference} on {Intelligent} {Sustainable} {Systems}, {ICISS} 2025},
	author = {Arepalli, Peda Gopi and Chennamsetti, Sravya and Poluri, Mary Midhila and Kumpati, Sukanya and Pulugujju, Rathna Kumari and Karanki, Hemasri},
	year = {2025},
	pages = {1235 -- 1239},
	file = {PDF:files/366/Arepalli et al. - 2025 - Corn Leaf Disease Detection using Quantum CNN.pdf:application/pdf},
}

@inproceedings{sumithra_large_2025,
	title = {Large {Language} {Model} {AI} {Text} {Generation} {Detection} based on {Transformer} {Deep} {Fast} {Quantum} {Convolutional} {Neural} {Networks}},
	isbn = {979-8-3315-2142-4},
	doi = {10.1109/ICIRCA65293.2025.11089509},
	abstract = {As the use of AI-generated text increases, so does the need to identify such content and prevent such inappropriative intents such as misinformation, plagiarism, and unauthorized content generation. The Deep Fast Quantum Convolutional Neural Network (DF-QCNN) has become a promising model for such a use as quantum computing can help improve feature extraction and classification. But for the DF-QCNN, it is somewhat complex in the sense that the weight parameters optimization has to be done on a high dimension, non-concave space. Previous optimization approaches including first and second order gradient descent techniques often take long time for convergence, are sensitive to local minimum and thus provide low accuracy. To overcome these limitations, it is proposed to use a novel metaheuristic algorithm called the Crayfish Optimization Algorithm (CFO) based on the movement behavior of crayfish in a complex environment. CFO is well structured to exercise both exploration and exploitation and maintain efficient optimization of weight parameters. The integration of CFO with the proposed DF-QCNN enhances text detection accuracy, shortens convergence time as well as increases computational efficiency than by using of traditional approaches of optimization. © 2025 IEEE.},
	booktitle = {Proceedings of the 6th {International} {Conference} on {Inventive} {Research} in {Computing} {Applications}, {ICIRCA} 2025},
	author = {{Sumithra} and Kiruba, G. Sweety Prasanna and {Srinivasan} and {Aishwarya} and {Sathya} and {Geetha}},
	year = {2025},
	pages = {997 -- 1003},
	file = {PDF:files/414/Sumithra et al. - 2025 - Large Language Model AI Text Generation Detection based on Transformer Deep Fast Quantum Convolution.pdf:application/pdf},
}

@inproceedings{karthik_brain_2025,
	title = {Brain {Tumour} {Detection} {Using} {Quantum} {Convolutional} {Neural} {Networks} ({QCNN})},
	isbn = {979-8-3315-7702-5},
	doi = {10.1109/OCIT66168.2025.11400476},
	abstract = {Brain tumor detection is a vital and challenging task in medical diagnosis, requiring highly precise and efficient methods to improve patient treatment outcomes. Traditional approaches rely on classical machine learning and deep learning techniques, which, while effective to a degree, often struggle with capturing the complex and high-dimensional patterns present in medical imaging data. A significant limitation of these conventional methods is their inability to process and analyze intricate features efficiently, which can impact diagnostic accuracy. To address these challenges, this work proposes a novel Quantum Convolutional Neural Network (QCNN) framework that combines quantum computing principles, via quantum circuits, with classical machine learning architectures implemented through tools like PyTorch and PennyLane. This hybrid approach enhances feature extraction and classification capabilities, leading to superior performance. Experimental results demonstrate that the QCNN model achieves an improved accuracy of 90 percent on the test dataset, surpassing traditional methods and showing promise for advancing brain tumor detection technology. This improvement is supported by consistent decreases in training and validation loss during model training, highlighting the robustness and efficacy of the quantum-enhanced model. © 2025 IEEE.},
	booktitle = {{OCIT} 2025 - {Proceedings} 23rd {OITS} {International} {Conference} on {Information} {Technology}},
	author = {{Karthik} and {Snehanvitha} and Kumar, Addanki Sai and Teella, Dattatreya and Shreya, R. Naga and Ramanathan, Shalini},
	year = {2025},
	pages = {588 -- 593},
	file = {PDF:files/362/Karthik et al. - 2025 - Brain Tumour Detection Using Quantum Convolutional Neural Networks (QCNN).pdf:application/pdf},
}

