	title = {Hybrid {Quantum} {Convolutional} {Neural} {Networks} in {TensorFlow} {Quantum}},
	isbn = {978-1-6654-5227-4},
	doi = {10.1109/ISSC55427.2022.9826145},
	abstract = {This paper presents a quantum convolutional neural network (QCNN) that classifies the happy and sad emotions from the fabled facial emotion recognition dataset (FER), FER-2013. The model uses the data re-uploading concept on the qubit(s) of the parameterized quantum circuits (PQCs) in the quantum convolutional layer of the hybrid QCNN model, which achieved a 70.25 \% validation accuracy on the test set. Later, a model averaging ensemble approach was implemented which yielded results motivating further investigation. © 2022 IEEE.},
