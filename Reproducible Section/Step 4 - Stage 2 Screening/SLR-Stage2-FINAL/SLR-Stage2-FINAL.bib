@article{chalumuri_quantumclassical_2022,
	title = {Quantum–{Classical} {Image} {Processing} for {Scene} {Classification}},
	volume = {6},
	issn = {2475-1472},
	doi = {10.1109/LSENS.2022.3173253},
	abstract = {Deep-learning-based convolutional neural network (CNN) models are prominent in processing and analyzing sensor signal data, such as images for classification. Data augmentation is a powerful technique used in training such models to avoid overfitting and to improve accuracy. This letter proposes a data augmentation technique using a quantum circuit for image data. The proposed quantum circuit is suitable to implement on real hardware provided by the IBM Quantum Experience platform. In comparison with other classical data augmentation techniques, the proposed technique increased the prediction accuracy of the CNN from 68.65 to 76.03\%. However, CNN models for image classification use many parameters during the training process. Quantum computers can efficiently handle large-scale data inputs using qubits for information processing. Hence, we also propose a hybrid quantum–classical convolutional neural network model (HQCNN) for scene classification. The proposed model uses a combination of CNN layers and quantum layers to process images. The proposed HQCNN reduces parameters used for training due to the use of quantum layers in the model. Our experimental results show that the proposed HQCNN can classify the scenes in the UC Merced land-use dataset with an accuracy of 85.28\% compared to the other models.},
	number = {6},
	journal = {IEEE Sensors Letters},
	publisher = {IEEE},
	author = {Chalumuri, A. and Kune, R. and Kannan, S. and Manoj, B. S.},
	year = {2022},
	keywords = {EPPI-Reviewer, hybrid model, quantum–classical computing, scene classification, sensor signal processing, Sensor signal processing},
	pages = {1 -- 4},
	file = {PDF:files/470/Chalumuri et al. - 2022 - Quantum–Classical Image Processing for Scene Classification.pdf:application/pdf},
}

@article{lin_quantum_2025,
	title = {Quantum {Parallel} {Transformer} {Model} for {Detecting} {Multiclass} {Insulator} {Faults}},
	volume = {74},
	issn = {1557-9662},
	doi = {10.1109/TIM.2025.3591852},
	abstract = {The mainstream detection model suffers from low insulator fault detection accuracy caused by the limitations of the complex background of unmanned aerial vehicle (UAV) images and the large variation of fault scales. Therefore, this study presents a multiclass insulator fault DETR (MCIF-DETR) based on real-time detection Transformer (RT-DETR) for locating multiclass insulator fault regions in complex backgrounds. First, this study proposes a multidirectional feature enhancement (MDFE) module to reduce information loss during network delivery. Second, to address the problem that the original backbone network cannot extract target features effectively, an efficient partially reparameterized convolutional network (EPRC-Net) is proposed to focus on target features. Then, a pyramidal feature aggregation distribution network is proposed to enhance the multiscale target detection capability of the model by passing the aggregated global information to each feature level. Finally, this study introduces a quantum convolutional neural network (QCNN) in parallel with EPRC-Net for feature extraction to further augment the learning capability of MCIF-DETR. The results indicate that the average precision (AP) of the MCIF-DETR proposed in this study for the three classes of faults on the insulator dataset containing breakage, flashover, and drop faults is 96.7\%, 94.1\%, and 95.1\%, respectively. Compared to existing methods, MCIF-DETR achieves a more balanced detection performance for different fault types while maintaining high detection accuracy.},
	journal = {IEEE Transactions on Instrumentation and Measurement},
	publisher = {IEEE},
	author = {Lin, Y. and Yin, L.},
	year = {2025},
	keywords = {EPPI-Reviewer, Detection Transformer, end-to-end, insulator fault detection, parallel structure, quantum-inspired network, real time},
	pages = {1 -- 19},
	file = {PDF:files/460/Lin and Yin - 2025 - Quantum Parallel Transformer Model for Detecting Multiclass Insulator Faults.pdf:application/pdf},
}

@article{t_heart_2026,
	title = {Heart {Disease} {Prediction} {Using} {Hybrid} {Quantum}-{Classical} {Machine} {Learning} {Models}},
	doi = {10.1109/ICKECS70176.2026.11527728},
	abstract = {Cardiovascular diseases remain the leading cause of mortality globally, necessitating accurate diagnostic tools for early detection and intervention. This paper presents a comprehensive comparative and hybrid analysis of quantum and classical machine learning models for heart disease prediction using the UCI Cleveland dataset. We implement classical baseline models including Logistic Regression, Random Forest, Support Vector Machine (SVM), and XGBoost, alongside quantum models: Quantum Support Vector Machine (QSVM) with statevector fidelity kernels, Variational Quantum Classifier (VQC) with data-reuploading ansätze, and Quantum Convolutional Neural Networks (QCNN) with parametric pooling. The primary contribution is the development of a hybrid quantum classical ensemble meta-classifier that fuses predictions from all classical and quantum learners using XGBoost as a meta learner. Experiments conducted in Google Colab using Qiskit 1.2+ and Penny Lane 0.36+ demonstrate that the proposed hybrid ensemble achieves superior performance with 98.33accuracy, 100perfect AUC-ROC of 1.0, substantially outperforming standalone classical models (best: 88.33(best: 80hybrid model's superiority. These results underscore the potential of quantum feature spaces combined with classical decision boundaries in healthcare prediction systems, and demonstrate the immediate utility of hybrid quantum-classical integration in medical diagnostics on near-term quantum hardware.},
	journal = {2026 4th International Conference on Knowledge Engineering and Communication Systems (ICKECS)},
	publisher = {IEEE},
	author = {T, P. R. and D, V. and S, R.},
	year = {2026},
	keywords = {EPPI-Reviewer, Feature Hilbert Spaces, Healthcare Analytics, Heart Disease Prediction, Hybrid Ensemble, Medical AI, QCNN, QSVM, Quantum Computing, Quantum Machine Learning, Variational Quantum Classifier},
	pages = {1 -- 6},
	file = {PDF:files/383/T et al. - 2026 - Heart Disease Prediction Using Hybrid Quantum-Classical Machine Learning Models.pdf:application/pdf},
}

@article{jia_electricity_2025,
	title = {Electricity {Theft} {Detection} in {Smart} {Meters} {Based} on {Quantum} {Convolutional} {Neural} {Networks}},
	doi = {10.1109/IESES66335.2025.11359777},
	abstract = {To address electricity theft in smart meters within smart grids, this paper proposes a theft detection model based on a one-dimensional quantum convolutional neural network (1D-QCNN) to identify anomalous behaviors in users' electricity consumption data. The proposed model comprises a quantum encoding layer, alternately arranged quantum convolution and pooling layers, and a classical fully connected layer. By leveraging the parallelism of quantum computing and the feature extraction capabilities of convolutional neural networks, the model effectively captures the nonlinear characteristics of electricity theft behavior. Experiments conducted on the Irish Smart Energy Trial dataset demonstrate that, under the scenario of daily electricity consumption per user, the model achieves a detection accuracy of 87.07 \% while maintaining a lightweight architecture. These results indicate strong potential and effectiveness of the model in electricity theft detection tasks.},
	journal = {2025 IEEE 4th International Conference on Industrial Electronics for Sustainable Energy Systems (IESES)},
	publisher = {IEEE},
	author = {Jia, H. and Li, Y. and Li, G. and Wang, Q.},
	year = {2025},
	keywords = {EPPI-Reviewer, electricity theft detection, quantum convolutional neural network, smart meters, variational quantum circuit},
	pages = {310 -- 315},
	file = {PDF:files/374/Jia et al. - 2025 - Electricity Theft Detection in Smart Meters Based on Quantum Convolutional Neural Networks.pdf:application/pdf},
}

@article{mishra_human_2025,
	title = {Human {Activity} {Recognition} {From} {Radar} {Signals} {Based} on {FBSE}-{EWT} and {Quantum} {Convolution} {Neural} {Network}},
	volume = {9},
	issn = {2475-1472},
	doi = {10.1109/LSENS.2025.3593355},
	abstract = {Frequency-modulated continuous wave (FMCW) radar signals reflected from the human activities are analyzed to enable accurate recognition and classification, forming the basis for activity recognition applications. The analysis of micro- and macromotions of human activities plays a vital role in automatic detection of suspicious activity in smart home automation and clinical applications. The use of convolutional neural networks (CNNs) with time–frequency representations (TFRs) for human activity recognition (HAR) is limited due to their reliance on large datasets, poor generalization to complex radar signals, and large model size. To mitigate these limitations, a novel Fourier–Bessel series expansion (FBSE)-based empirical wavelet transform (FBSE-EWT) and quantum CNN (QCNN)-based approach is proposed. The FBSE-EWT method is utilized for the TFRs of a reflected multicomponent nonstationary signal with enhanced frequency resolution. The QCNN effectively classifies the human activities, enabling accurate and efficient HAR. The HAR from radar signals based on FBSE-EWT and QCNNs has not been studied earlier based on our knowledge. This is the first instance to utilize the proposed method for HAR using FMCW radar signals. We have also conducted extensive study of FBSE-EWT-based method with CNN approaches (such as GoogLeNet and VGG19) in the same framework. The proposed approach achieves 95.71\% test accuracy compared to existing CNNs, demonstrating its superior performance for HAR.},
	number = {9},
	journal = {IEEE Sensors Letters},
	publisher = {IEEE},
	author = {Mishra, K. K. and Pachori, R. B.},
	year = {2025},
	keywords = {EPPI-Reviewer, Sensor signal processing, Fourier–Bessel series expansion-based empirical wavelet transform (FBSE-EWT), frequency-modulated continuous wave (FMCW) radar, human activity recognition (HAR), nonstationary signals, quantum convolutional neural network (QCNN)},
	pages = {1 -- 4},
	file = {PDF:files/386/Mishra and Pachori - 2025 - Human Activity Recognition From Radar Signals Based on FBSE-EWT and Quantum Convolution Neural Netwo.pdf:application/pdf},
}

