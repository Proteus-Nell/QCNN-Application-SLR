	isbn = {979-8-3315-9657-6},
	doi = {10.1109/SISY67000.2025.11205415},
	abstract = {Quantum Machine Learning (QML) has become a promising alternative in the field of network anomaly detection (NAD) in recent years, especially in intrusion detection. in the development of intrusion detection systems (IDS). The aim of this study is to examine in detail four quantum machine learning models that were run not on simulators but on real quantum computers, including IBM QPU and IonQ Aria-1 platforms. The analyzed research uses different architectures, such as Quantum Convolutional Neural Network (QCNN), Variational Quantum Classifier (VQC), Quantum Autoencoder (QAE) and Quantum Neural Network (QNN), combined with multiple data processing methods and encoding techniques. © 2025 IEEE.},
