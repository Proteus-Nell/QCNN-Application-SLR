	file = {Full Text PDF:files/298/Choi et al. - 2026 - Spectral Efficiency Enhancement in Active and Passive RIS-Assisted Systems Using Quantum Convolution.pdf:application/pdf},
}

@inproceedings{chandra_novel_2022,
	title = {A {Novel} {Framework} {For} {Brain} {Disease} {Classification} {Using} {Quantum} {Convolutional} {Neural} {Network}},
	isbn = {979-8-3503-1156-3},
	doi = {10.1109/WIECON-ECE57977.2022.10150851},
	abstract = {More than 3,410 children and teens (under the age of 20) in India suffer from catastrophic brain disorders and the creation of abnormal brain cells each year, according to recent reports on the country's rapid increase in brain ailments. It is difficult to quantify the survival rate of human patients due to the rarity, variability, and abnormal development of tumors. These patients cannot be accurately predicted using machine learning approaches for early diagnosis. These methods need a huge amount of discriminatory information and processing time based on annotated limited brain image datasets to classify diseases. To solve this problem, we proposed a novel model based on Quantum Convolutional Neural Network techniques for early diagnosis of tumors in a less invasive manner that may reduce the number of operations and more precisely define the kind of therapy needed. The proposed framework uses image processing techniques to remove noise and other specific artifacts from the brain images. After that, the processed images are segmented into distinct regions of interest using machine learning techniques. The suggested framework uses deep quantum approaches to identify brain disorders based on extracted discriminating characteristics from the brain images, such as textures and qubit features, enabling reliable prediction of brain disorders. The proposed system provided 93.99\% accuracy for the accurate prediction of brain diseases using classical models and 88.7\% accuracy using the Quantum Convolutional Neural Network (QCNN) model. © 2022 IEEE.},
	booktitle = {Proceedings of 2022 {IEEE} {International} {Women} in {Engineering} ({WIE}) {Conference} on {Electrical} and {Computer} {Engineering}, {WIECON}-{ECE} 2022},
	author = {Chandra, Sanskriti and Saxena, Shivam and Kumar, Santosh and Chaube, Mithilesh Kumar and Bodhey, Narendra Kuber},
	year = {2022},
	pages = {346 -- 351},
	file = {PDF:files/347/Chandra et al. - 2022 - A Novel Framework For Brain Disease Classification Using Quantum Convolutional Neural Network.pdf:application/pdf},
}

@inproceedings{qi_variational_2025,
	title = {Variational {Quantum} {Convolutional} {Neural} {Network} {Based} on {Particle} {Swarm} {Optimization}},
	isbn = {979-8-3315-5374-6},
	doi = {10.1109/NGDN66208.2025.11182265},
	abstract = {With the rapid development of the Internet and digitalization, cybersecurity threats have become increasingly severe, and traditional intrusion detection techniques struggle to address the growing complexity of network attacks. Machine learning-based intrusion detection models face limitations in detection accuracy. To overcome the shortcomings of traditional methods in identifying intrusions with high precision, this paper proposes a Variational Quantum Convolutional Neural Network (VQCNN) model optimized using Particle Swarm Optimization (PSO) to improve detection accuracy and generalization capability. By leveraging PSO to optimize the parameters of variational quantum circuits, the proposed model integrates quantum properties with intelligent optimization algorithms, enabling more efficient processing of complex data features. The UNSW-NB15 network intrusion detection dataset was used for experimental validation, and the results demonstrate that the proposed PSO-VQCNN model achieves an accuracy of 96.25\%, outperforming other traditional intrusion detection models such as Artificial Neural Networks (ANN), Support Vector Machines (SVM), k-Nearest Neighbors (k-NN), Naive Bayes, and Decision Trees. This highlights the potential and challenges of combining variational quantum circuits with intelligent algorithms. © 2025 IEEE.},
	booktitle = {2025 7th {International} {Conference} on {Next} {Generation} {Data}-{Driven} {Networks}, {NGDN} 2025},
	author = {Qi, Han and Zhang, Jiashuai and Lv, Xinyue and Gani, Abdullah},
	year = {2025},
	pages = {134 -- 137},
	file = {PDF:files/485/Qi et al. - 2025 - Variational Quantum Convolutional Neural Network Based on Particle Swarm Optimization.pdf:application/pdf},
}

@inproceedings{santhoshkumar_toward_2026,
	title = {Toward {Quantum}-{Enabled} {Medical} {Imaging}: {Optimized} {CNNs} for {Diagnosis}},
	isbn = {979-8-3315-8949-3},
	doi = {10.1109/ESCI68015.2026.11493187},
	abstract = {The recent accelerated development of quantum computing has offered new avenues of re-conceptualization of classical architecture-constrained computational models. Quantum Convolutional Neural Networks (QCNNs) can also be leveraged on the principles of quantum mechanics to provide a fundamentally improved framework on the analysis of medical images. In contrast to classical CNNs, QCNNs take advantage of quantum parallelism and entanglement to find discriminative features more effectively and allows analyzing high-dimensional image patterns simultaneously and does not highly rely on massive annotated datasets. This quantum benefit does not only improve the feature mapping quicker rate but also improves the classification performance in a particular situation of scarce or nonhomogeneous medical information. More so, QCNN models are also naturally resilient to noise, and can maintain a high diagnostic accuracy under the conditions of fluctuation in image quality, which is a critical attribute in clinical settings. Experimental assessment on dataset of chest X-rays with labels of samples of Types-Covid-19, Pneumonia andNormal results in significant gains in speed of inference, discrimination of features and generalization. The results reveal the potential of quantum-driven imaging designs in disrupting the diagnostic platform; which refined QCNN designs could lead to significant improvements in the diagnostic platforms to the extent of improving the reliability of the decision and clinical impact. © 2026 IEEE.},
	booktitle = {2026 {International} {Conference} on {Emerging} {Smart} {Computing} and {Informatics}, {ESCI} 2026},
	author = {{Santhoshkumar} and {Rajaambika} and {Prameen} and {Loganathan} and {Bargunan} and {Deepika}},
	year = {2026},
	file = {PDF:files/481/Santhoshkumar et al. - 2026 - Toward Quantum-Enabled Medical Imaging Optimized CNNs for Diagnosis.pdf:application/pdf},
}

