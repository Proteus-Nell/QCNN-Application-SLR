	isbn = {979-8-4007-2173-1},
	doi = {10.1145/3796315.3796354},
	abstract = {This paper compares the performance of a quantum convolutional neural network (QCNN) and a conventional CNN for signal detection in a RIS-assisted single-user downlink (SU-MISO) system, covering both passive and active RIS models. Assuming perfect channel state information (CSI), the RIS phases are optimized using an SVD-based method. Monte Carlo simulations show that the QCNN outperforms the CNN while using far fewer trainable parameters, resulting in a substantially smaller model. The study focuses on parameter efficiency alongside performance gains. © 2026 Copyright held by the owner/author(s)},
