	doi = {10.23919/JCN.2025.000021},
	abstract = {Real-time processing with high classification accuracy is a fundamental requirement in autonomous driving systems. However, existing neural network models for classification often face a tradeoff between computational efficiency and accuracy, necessitating the development of advanced optimization methods to address this limitation. Additionally, dynamic driving environments offer opportunities to enhance classification performance by leveraging the principles of quantum computing, particularly the properties of superposition and entanglement. In response to these challenges, a multi-stage quantum convolutional neural network (MS-QCNN) approach is proposed, designed to improve image analysis performance by effectively utilizing the multi-stage structure of QCNN. A Lyapunov optimization framework is applied to achieve optimal performance, which maximizes time-averaged efficiency while ensuring system stability. This framework dynamically adjusts the MS-QCNN model in response to environmental variations, promoting enhanced queue stability and achieving optimal time-averaged performance.},
	number = {4},
	journal = {Journal of Communications and Networks},
	publisher = {KICS},
	author = {Roh, E. J. and Park, S. and Jung, S. and Kim, J.},
	year = {2025},
	keywords = {Autonomous driving, EPPI-Reviewer, Lyapunov optimization, multi-stage quantum convolutional neural network},
	pages = {264 -- 272},
	file = {Full Text PDF:files/336/Roh et al. - 2025 - Stabilized classification control using multi-stage quantum convolutional neural networks for autono.pdf:application/pdf},
}

@article{lawrence_medical_2025,
	title = {Medical {Image} {Recognition} for {Breast} {Cancer} {Detection} {Using} {Hybrid} {Quantum}-{Classical} {Deep} {Learning}},
	doi = {10.1109/IC-EETA66496.2025.11548221},
	abstract = {One of the common and maybe fatal diseases harming women all around, breast cancer is one such condition. Accurate medical image analysis allows for early detection, which can greatly increase survival rates. Although they encounter challenges such as high computational expenses, poor data efficiency, and suboptimal feature extraction, conventional deep learning methods have produced promising results. By using quantum parallelism and entanglement to enable more quick and more complex computations, quantum computing provides a new approach to overcome these limitations. This paper intends to propose a hybrid quantum-classical deep learning model for the identification of breast cancer areas in mammographic images. The proposed method combines a quantum convolutional neural network (QCNN) with a classical convolutional neural network (CNN) to benefit from the advantages accompanying both classical and quantum processing. The hybrid model processes the mammogram data using classical pre-processing and quantum convolution layers; classification then follows with fully connected layers followed by classical pooling. The results of the MIAS dataset experiments indicate a classification accuracy of 98.4\%, which is superior to the operation of traditional CNN and transfer learning-based models.},
	journal = {2025 International Conference on Emerging Engineering Technologies and Applications (IC-EETA)},
	publisher = {IEEE},
	author = {Lawrence, T. S. and Margala, M. and Chakrabarti, P. and S, S. S. and G, N.},
	year = {2025},
	keywords = {breast cancer detection, EPPI-Reviewer, hybrid deep learning, medical image analysis, Quantum computing, quantum convolutional neural network},
	pages = {829 -- 833},
	file = {PDF:files/409/Lawrence et al. - 2025 - Medical Image Recognition for Breast Cancer Detection Using Hybrid Quantum-Classical Deep Learning.pdf:application/pdf},
}

@article{makam_eye_2025,
	title = {Eye {Movement} {Detection} {Based} on {SM}-{SSA} and {Quantum} {CNN} from {EMG} of {EOM} {Signals}},
	volume = {9},
	issn = {2475-1472},
	doi = {10.1109/LSENS.2025.3550346},
	abstract = {Analysis and classification of electromyogram (EMG) signals are pivotal for developing assistive technologies. These signals are nonstationary in nature and require nonstationary signal processing methods for their analysis. In this study, the sliding mode singular spectrum analysis (SM-SSA) method is considered for analysis of EMG of extraocular muscles (EOM) signals. Furthermore, we propose a new framework combining SM-SSA and quantum convolutional neural network (QCNN) for the task of eye movement detection. The SM-SSA decomposes EMG of EOM signals into its constituent components from which features are extracted. The neighborhood component analysis is used to obtain the optimal set of features which are classified into different eye movement classes using QCNN classifier. The proposed framework achieved a classification accuracy of 98.70\%, outperforming compared methods from literature.},
	number = {5},
	journal = {IEEE Sensors Letters},
	publisher = {IEEE},
	author = {Makam, K. K. and Singh, V. K. and Pachori, R. B.},
	year = {2025},
	keywords = {electromyogram (EMG) of extraocular muscles (EOM), EPPI-Reviewer, neighborhood components analysis, quantum convolutional neural networks (QCNNs), Sensor applications, sliding mode singular spectrum analysis (SM-SSA)},
	pages = {1 -- 4},
	file = {PDF:files/379/Makam et al. - 2025 - Eye Movement Detection Based on SM-SSA and Quantum CNN from EMG of EOM Signals.pdf:application/pdf},
}

@article{makam_als_2024,
	title = {{ALS} {Detection} {Framework} {Based} on {Automatic} {Singular} {Spectrum} {Analysis} and {Quantum} {Convolutional} {Neural} {Network} {From} {EMG} {Signals}},
	volume = {8},
	issn = {2475-1472},
	doi = {10.1109/LSENS.2024.3449369},
	abstract = {Electromyogram (EMG) signals are recordings of the electrical activity in muscles, which are studied due to their informative nature regarding neuromuscular disorders. Analysis of EMG signals is invaluable for identifying various neuromuscular conditions. In this letter, an automatic singular spectrum analysis (Auto-SSA) and quantum convolutional neural network (QCNN)-based framework is proposed for the detection of amyotrophic lateral sclerosis (ALS) using EMG signals. The Auto-SSA effectively decomposes the EMG signals into reconstructed components, from which the particle swarm optimization extracts the most significant features. The QCNN classifies the extracted features for efficient ALS detection. The proposed framework outperforms the compared state-of-the-art ALS detection frameworks, achieving a testing accuracy of 98.50\%. With the obtained performance, the proposed framework could be a valuable diagnostic tool for ALS neuromuscular conditions.},
	number = {9},
	journal = {IEEE Sensors Letters},
	publisher = {IEEE},
	author = {Makam, K. K. and Singh, V. K. and Pachori, R. B.},
	year = {2024},
	keywords = {amyotrophic lateral sclerosis (ALS) identification, and quantum machine learning, automatic singular spectrum analysis (Auto-SSA), electromyogram (EMG), EPPI-Reviewer, particle swarm optimization (PSO), quantum convolutional neural network (QCNN), Sensor applications},
	pages = {1 -- 4},
	file = {PDF:files/352/Makam et al. - 2024 - ALS Detection Framework Based on Automatic Singular Spectrum Analysis and Quantum Convolutional Neur.pdf:application/pdf},
}

@article{jhansi_quantum_2025,
	title = {Quantum {Convolutional} {Neural} {Network} {Framework} for {Efficient} and {Accurate} {Plant} {Disease} {Diagnosis}},
	doi = {10.1109/ICECST66106.2025.11307653},
	abstract = {Plants are susceptible to numerous illnesses during their growth stages, rendering early diagnosis a significant challenge in contemporary agriculture. Not being able to find infections early on can greatly lower agricultural yields and hurt farmers' incomes. There are several new methods that use Machine Learning and Deep Learning to solve this problem; however they generally have low classification accuracy or need millions of trainable parameters, which makes them less efficient. To overcome these limitations, this study proposes a Quantum Convolutional Neural Network (QCNN) model for the automated detection of plant diseases. To the best of our knowledge, there is currently no literature that has investigated QCNNs for this purpose. This work employs the proposed approach to detect Bacterial Spot disease in peach plants utilizing leaf photos from the publicly accessible Plant Village dataset. The system only needs 9,914 trainable parameters to work, and it gets 94.96 \% accuracy. These results show that QCNNs are good at predicting plant diseases and could be useful in other areas of agriculture as well.},
	journal = {2025 2nd International Conference on Electronic Circuits and Signaling Technologies (ICECST)},
	publisher = {IEEE},
	author = {Jhansi, G. and Sudhakar, P. and Surya, C. C. and Kumar, A. K. and Chunduru, M. R. and Satyanarayana, G.},
	year = {2025},
	keywords = {Bacterial Spot, EPPI-Reviewer, Lightweight Model, Plant Disease Detection, Plant Village Dataset, Precision Agriculture, Quantum Convolutional Neural Network (QCNN)},
	pages = {934 -- 939},
	file = {PDF:files/445/Jhansi et al. - 2025 - Quantum Convolutional Neural Network Framework for Efficient and Accurate Plant Disease Diagnosis.pdf:application/pdf},
}

@article{nguyen_hq-cnn_2026,
	title = {{HQ}-{CNN}: {Hybrid} {Quantum}-{CNN} for {Precise} {Radio}-{Based} {Indoor} {Tracking} in {mmWave} {Networks}},
	issn = {1558-2612},
	doi = {10.1109/WCNC65185.2026.11555410},
	abstract = {Radio-based indoor localization is vital for the Internet of Things (IoT) applications such as smart healthcare. However, existing methods often require intrusive infrastructure or lack sufficient resolution for through-wall tracking. To address this, we propose a hybrid quantum-convolutional neural network-based framework (HQ-CNN) for high-precision localization in massive MIMO environments. The primary motivation for exploiting quantum-inspired techniques is to reduce model size and computational overhead through quantum data encoding, which is essential for resource-constrained IoT devices. Accordingly, the framework first extracts temporal channel state information, such as angle of arrival (AoA), to generate dynamic Angle-Delay Profiles (ADPs), capturing interactions with both static and moving objects. A generative adversarial network (GAN)-based frame prediction is employed for noise suppression and ADP refinement. The core innovation lies in the integration of a hybrid quantum-CNN, which improves learning from high-dimensional ADPs while maintaining low computational and memory overhead on a traditional GPU-based computer. Evaluations on DeepMIMO show the framework outperforms baselines in scalability and competes with their accuracy. This work demonstrates the potential of hybrid quantum-classical technologies for precise radio-based tracking.},
	journal = {2026 IEEE Wireless Communications and Networking Conference (WCNC)},
	publisher = {IEEE},
	author = {Nguyen, V.-L. and Nguyen, L.-H. and Hwang, R.-H.},
	year = {2026},
	keywords = {EPPI-Reviewer, Hybrid quantum CNN, quantum-classical learning, Radio Localization, User tracking},
	pages = {1 -- 6},
	file = {PDF:files/385/Nguyen et al. - 2026 - HQ-CNN Hybrid Quantum-CNN for Precise Radio-Based Indoor Tracking in mmWave Networks.pdf:application/pdf},
}

@article{sebastianelli_circuit-based_2022,
	title = {On {Circuit}-{Based} {Hybrid} {Quantum} {Neural} {Networks} for {Remote} {Sensing} {Imagery} {Classification}},
	volume = {15},
	issn = {2151-1535},
	doi = {10.1109/JSTARS.2021.3134785},
	abstract = {This article aims to investigate how circuit-based hybrid quantum convolutional neural networks (QCNNs) can be successfully employed as image classifiers in the context of remote sensing. The hybrid QCNNs enrich the classical architecture of convolutional neural networks by introducing a quantum layer within a standard neural network. The novel QCNN proposed in this work is applied to the land-use and land-cover classification, chosen as an Earth observation (EO) use case, and tested on the EuroSAT dataset used as the reference benchmark. The results of the multiclass classification prove the effectiveness of the presented approach by demonstrating that the QCNN performances are higher than the classical counterparts. Moreover, investigation of various quantum circuits shows that the ones exploiting quantum entanglement achieve the best classification scores. This study underlines the potentialities of applying quantum computing to an EO case study and provides the theoretical and experimental background for future investigations.},
	journal = {IEEE Journal of Selected Topics in Applied Earth Observations and Remote Sensing},
	publisher = {IEEE},
	author = {Sebastianelli, A. and Zaidenberg, D. A. and Spiller, D. and Saux, B. L. and Ullo, S. L.},
	year = {2022},
	keywords = {Earth observation (EO), EPPI-Reviewer, image classification, land-use and land-cover (LULC) classification, machine learning (ML), quantum computing (QC), quantum machine learning (QML), remote sensing},
	pages = {565 -- 580},
	file = {Full Text PDF:files/283/Sebastianelli et al. - 2022 - On Circuit-Based Hybrid Quantum Neural Networks for Remote Sensing Imagery Classification.pdf:application/pdf},
}

@article{qi_multi-path_2026,
	title = {Multi-{Path} {Parallel} {Quantum} {Convolutional} {Neural} {Network}},
	doi = {10.1109/MAI69289.2026.11543763},
	abstract = {Quantum Convolutional Neural Networks (QCNN) migrate the convolution and pooling concepts of classical Convolutional Neural Networks (CNN) to variational quantum circuits, showing potential on Noisy Intermediate-Scale Quantum (NISQ) devices. However, traditional QCNN adopts a single-depth circuit structure, which has limitations in multi-scale feature extraction, and is prone to the barren plateau phenomenon during training, making it difficult to adapt to high-dimensional real-world scenarios such as network intrusion detection. This paper proposes a QCNN architecture based on a multi-path parallel structure. For the network intrusion detection task, it draws on the Inception module to construct three parallel quantum convolution paths: shallow, medium, and deep, achieving hierarchical extraction of multi-scale features; residual connections are introduced to preserve encoded state information and provide gradient shortcuts; a hybrid optimization strategy combining classical Adam and Quantum Natural Gradient (QNG) is adopted to adapt to the heterogeneous parameter space. Experimental validation shows that, on the UNSW-NB15 network intrusion detection dataset, the proposed Multi-Path Parallel Quantum Convolutional Neural Network (MP-QCNN) improves detection accuracy by 3\% compared to traditional single-path QCNN and effectively mitigates the barren plateau phenomenon. This design strictly maintains NISQ depth constraints and quantum parallelism advantages, providing an efficient and stable feature extraction framework for high-dimensional tasks such as network intrusion detection.},
	journal = {2026 International Conference on Multi-scale Artificial Intelligence (MAI)},
	publisher = {IEEE},
	author = {Qi, H. and Huo, X. and Gani, A.},
	year = {2026},
	keywords = {EPPI-Reviewer, Inception Migration, Multi- Path Parallel Structure, Quantum Convolutional Neural Network, Quantum Natural Gradient, Residual Connection},
	pages = {1 -- 6},
	file = {PDF:files/406/Qi et al. - 2026 - Multi-Path Parallel Quantum Convolutional Neural Network.pdf:application/pdf},
}

@article{chou_quantum_2025,
	title = {Quantum {Convolutional} {Neural} {Networks} in {Injury} {Detection} of {3D} {Computed} {Tomography} {Volumes}},
	doi = {10.1109/BigData66926.2025.11401688},
	abstract = {The growing prospect of incorporating artificial intelligence into medical diagnosis to enhance the healthcare system necessitates methods to improve the accuracy of classification models capable of processing complex information, such as computed tomography images. Quantum machine learning has garnered attention because of the superior computational capacity of qubits, which may lead to improved pattern recognition and data analysis. However, there is limited information on its ability to process 3D computed tomography volumes, especially from real-world datasets such as the RSNA Abdominal Trauma Injury CT (RATIC) Dataset that present data with more variability and irrelevant details. This study addresses this by proposing four HQCNN MIL-based model variations and evaluating them against a baseline classical model to determine an optimal classification model architecture for the RATIC Dataset. The model is part of a comprehensive data processing pipeline, which involves a 3D CNN image segmentation model that has been modified to increase dimensionality and to incorporate a ResNet encoder. While the performance of two HQCNNs is similar to the baseline, that of the other two is consistently higher, with score differences of approximately 0.06 to 0.13. The results indicate that even with 3D CT data, hybrid machine learning models have the potential to surpass purely classical configurations only when optimally designed, suggesting that careful integration of quantum methods into machine learning pipelines plays a key role in advancing diagnostic accuracy and reliability in clinical practice. Overall, these findings highlight the need for continued exploration of hybrid architectures, particularly in optimizing quantum-classical interactions for robust performance on real-world medical data. © 2025 IEEE.},
	number = {2025},
	journal = {Proceedings of the IEEE International Conference on Big Data, BigData},
	author = {Chou, Li-Yen Alyssa and Islam, Md Majedul and He, Selena},
	year = {2025},
	note = {ISBN: 979-833159447-3},
	pages = {7055 -- 7063},
	file = {PDF:files/452/Chou et al. - 2025 - Quantum Convolutional Neural Networks in Injury Detection of 3D Computed Tomography Volumes.pdf:application/pdf},
}

@inproceedings{isawi_eliminate_2022,
	title = {Eliminate {Entanglement} in {Quantum} {Information} {Processing} {Utilizing} {Hybrid} {Quantum}-{Classical} {Neural} {Networks}},
	isbn = {978-1-6654-6835-0},
	doi = {10.1109/HORA55278.2022.9799832},
	abstract = {A particle generated inside a group cannot be described independently of the other group particles during the interaction, sharing, or the development of a particle's group in close geographic in the quantum mechanics. Particles' arrangement represents their quantum states at zero temperature and highlights the particle's energy and symmetry gap during the Symmetry Protected Topology SPT as the 'trivial' topological instructions' existence of these particles and provides a more consistent method for differentiating the quantum data source's features such as a quantum sensor or an intricate simulation of a device through quantum entanglement. In this research utilizing the TensorFlow framework with a cluster state as a data source which mayor may not excited, the researcher demonstrates and evaluates a quantum variant of the conventional classical neural network (CNN) called the hybrid quantum-classical convolutional neural network (HQCNN) which is trained on data containing a quantum mechanical state protected by the SPT topology. The accuracy was determined in purely model's results did not exceed 89.58\% accuracy within ten epochs, whereas the hybrid model's results were accurate to 100\% within three epochs with a single (Twist) filter and seven epochs with a multi-filter (multi-Twist) model with the goal of eliminating quantum entanglement. © 2022 IEEE.},
	booktitle = {{HORA} 2022 - 4th {International} {Congress} on {Human}-{Computer} {Interaction}, {Optimization} and {Robotic} {Applications}, {Proceedings}},
	author = {Isawi, Ather Salah Hadi Al and Cevik, Mesut},
	year = {2022},
	file = {PDF:files/375/Isawi and Cevik - 2022 - Eliminate Entanglement in Quantum Information Processing Utilizing Hybrid Quantum-Classical Neural N.pdf:application/pdf},
}

@inproceedings{pandian_symmetry-protected_2022,
	title = {Symmetry-{Protected} {Topological} {Phase} {Classification} {Using} {Hybrid} {Quantum} {Convolutional} {Neural} {Network} with {Three} {Quantum} {Filters}},
	isbn = {978-1-6654-1120-2},
	doi = {10.1109/ICAECT54875.2022.9807939},
	abstract = {In this research, a Hybrid Quantum Convolutional Neural Network (HQCNN) was proposed for Symmetry-Protected Topological (SPT) Phase data Classification. The HQCNN used quantum Convolutional and pooling layers with traditional fully connected networks. The quantum Convolutional (QConv) and quantum pooling (QPool) layers were developed using quantum circuit states. The TensorFlow quantum package was used to add the outcomes of the quantum circuits to dense layers for efficient classification. A different number of quantum filters were used in the HQCNN model and tested. A different number of quantum filters were used in the HQCNN model design. The performance of the HQCNN models with the different number of quantum filters was compared using validation and testing performance. The simulation results showed that the classification accuracy of the proposed HQCNN with Four Quantum Filters (HQCNN-4QF) was superior to other proposed HQCNNs on the SPT phase data Classification. The HQCNN-4QF model achieved the classification accuracy of 99.22 on SPT phase test data. © 2022 IEEE.},
	booktitle = {2022 2nd {International} {Conference} on {Advances} in {Electrical}, {Computing}, {Communication} and {Sustainable} {Technologies}, {ICAECT} 2022},
	author = {Pandian, Arun and {Kanchanadevi} and Sandeep, Pasupuleti and {Dattatreya} and Anil, S. Naga Sai},
	year = {2022},
	file = {PDF:files/480/Pandian et al. - 2022 - Symmetry-Protected Topological Phase Classification Using Hybrid Quantum Convolutional Neural Networ.pdf:application/pdf},
}

@inproceedings{mewada_quantum_2025,
	title = {Quantum {Convolutional} {Neural} {Network} for {Bone} {Fracture} {Classification} from {X}-{Ray} {Images}},
	volume = {256},
	doi = {10.1016/j.procs.2025.02.222},
	abstract = {Accurate and efficient classification of bone fractures from X-ray images is crucial for timely diagnosis, effective treatment planning, and improved patient outcomes in orthopedic medicine. Convolutional neural networks (CNNs) have demonstrated their ability to automatically extract relevant features from X-ray images, making them a powerful tool for the classification of complex bone fracture patterns. However, as the complexity of the classification task increases, the computational requirements of classical CNNs also grow rapidly. This poses a challenge in high-stakes medical applications, where the accuracy and efficiency of the classification system are paramount. In this work, we present a quantum convolutional neural network (QCNN) for the classification of bone fractures from X-ray images. A quantum convolution layer is integrated as the first layer of the network, which leverages the unique properties of quantum mechanics to extract more informative features from the input X-ray images. A traditional CNN network follows this quantum-based feature extraction step to perform the final bone fracture classification. We tested the proposed QCNN model on the Bone Fracture Multi-Region X-ray Data, a benchmark dataset for evaluating bone fracture classification systems. The QCNN architecture achieved an impressive 96\% accuracy and 95.81\% F1-score, demonstrating its superior performance compared to state-of-The-Art classical CNN models. © 2025 The Author(s).},
	booktitle = {Procedia {Computer} {Science}},
	author = {Mewada, Hiren and Pires, Ivan Miguel and Rahevar, Mrugendrasinh and Khatri, Narendra},
	year = {2025},
	pages = {1143 -- 1150},
	file = {PDF:files/442/Mewada et al. - 2025 - Quantum Convolutional Neural Network for Bone Fracture Classification from X-Ray Images.pdf:application/pdf},
}

@article{naz_quantum_2023,
	title = {Quantum {Mechanism}-{Based} {Convolution} {Model} for the {Classification} of {Pathogenic} {Bacteria}},
	volume = {11},
	doi = {10.1109/ACCESS.2023.3339127},
	abstract = {Water, especially drinking water, should be clean and free of disease-causing bacteria because of its critical role in life. However, it isn't easy to identify and classify them rapidly at an early stage. Primarily, the examination of water is performed manually to check the contamination level. Some researchers have proposed techniques to detect and classify bacteria images, but this field still needs more attention. In this research work, a robust Quantum Convolutional Neural Network (QCNN) classification model is proposed to classify the six major categories of pathogenic bacteria. For the acquisition of pathogen images, different slides are created through the gram-staining process, and then images are captured from those slides. DIBaS is the publicly available dataset that provides these slides captured through gram-staining, which is used to evaluate the proposed methodology. So, in the first step, database preprocessing, small patches are extracted from slide images. However, the extracted patches were not clear and very useful, so the Enhanced Super-Resolution Generative Adversarial Network Model (ESRGAN) was applied to images to improve the image quality of extracted patches. The third step is to extract the deep features and classify bacterial images using the QCNN model, in which the Quantum Convolutional layer is added, and classical data is converted into quantum data to perform classification. Based on the results of classification experiments using the QCNN model, the accuracy is 96.54\%. © 2013 IEEE.},
	journal = {IEEE Access},
	author = {Naz, Isra and Shah, Jamal Hussain and Rehman, Muhammad Habib Ur and Rafiq, Muhammad and Choi, Gyu Sang},
	year = {2023},
	pages = {137747 -- 137757},
	file = {Full Text PDF:files/291/Naz et al. - 2023 - Quantum Mechanism-Based Convolution Model for the Classification of Pathogenic Bacteria.pdf:application/pdf},
}

